=BA=ACN(ACCEPTANCECRITERIA-AC)">2. TI=C3=8AU CH=C3=8D CH=E1=BA=A4P NH=E1=BA=
=ACN (ACCEPTANCE CRITERIA - AC)</h3>
<h4 class=3D"code-line" style=3D"" data-line=3D"15" id=3D"id-=E2=9C=85CS1.E=
5.US04:[C=E1=BA=A5pNL]Ti=E1=BA=BFpnh=E1=BA=ADnv=C3=A0Quy=E1=BA=BFt=C4=91=E1=
=BB=8Bnhsauchuy=E1=BB=83nch=E1=BA=BF-AC1:Giaodi=E1=BB=87n=C4=90oph=E1=BB=95=
&amp;Nh=E1=BA=ADnth=C3=A0nhph=E1=BA=A9m">AC 1: Giao di=E1=BB=87n =C4=90o ph=
=E1=BB=95 &amp; Nh=E1=BA=ADn th=C3=A0nh ph=E1=BA=A9m</h4>
<ul class=3D"code-line" style=3D"" data-line=3D"17">
 <li class=3D"code-line" data-line=3D"17" data-uuid=3D"14f31f28-00d5-41fd-9=
6be-a56f98834909"><strong>Given:</strong><span>&nbsp;</span>B=E1=BB=99 ph=
=E1=BA=ADn X=E1=BB=AD L=C3=BD (IOOO) =C4=91=C3=A3 ho=C3=A0n th=C3=A0nh m=E1=
=BA=BB chuy=E1=BB=83n ch=E1=BA=BF (Conversion Order - tr=E1=BA=A1ng th=C3=
=A1i Out) v=C3=A0 phi=E1=BA=BFu =C4=91ang =C4=91=C6=B0=E1=BB=A3c gi=E1=BB=
=AF b=E1=BB=9Fi m=E1=BB=99t MC Kho NL c=E1=BB=A5 th=E1=BB=83 (Assignee).</l=
i>
 <li class=3D"code-line" data-line=3D"18" data-uuid=3D"449ba7b7-7c55-4869-a=
7be-482d501f016d"><strong>When:</strong><span>&nbsp;</span>MC =C4=91ang gi=
=E1=BB=AF phi=E1=BA=BFu =C4=91=C3=B3 ch=E1=BB=8Dn "Ki=E1=BB=83m tra" t=E1=
=BB=AB phi=E1=BA=BFu Conversion Order.</li>
 <li class=3D"code-line" data-line=3D"19" data-uuid=3D"ce6a4317-9ef9-4da5-a=
287-f4fd47821690"><strong>Then:</strong><span>&nbsp;</span>H=E1=BB=87 th=E1=
=BB=91ng t=E1=BA=A3i Popup Ki=E1=BB=83m tra (t=C6=B0=C6=A1ng t=E1=BB=B1 lu=
=E1=BB=93ng Phi=E1=BA=BFu x=E1=BB=AD), hi=E1=BB=83n th=E1=BB=8B th=C3=B4ng =
tin Header c=E1=BB=A7a m=E1=BA=BB chuy=E1=BB=83n ch=E1=BA=BF v=C3=A0 m=E1=
=BB=99t Grid tr=E1=BB=91ng cho ph=C3=A9p nh=E1=BA=ADp danh s=C3=A1ch nguy=
=C3=AAn li=E1=BB=87u th=E1=BB=B1c nh=E1=BA=ADn. H=E1=BB=87 th=E1=BB=91ng va=
lidate: Kh=C3=B4ng cho ph=C3=A9p c=C3=A1c MC kh=C3=A1c thao t=C3=A1c "Ki=E1=
=BB=83m tra" ho=E1=BA=B7c "Nh=E1=BA=ADp kho" n=E1=BA=BFu kh=C3=B4ng ph=E1=
=BA=A3i l=C3=A0 ng=C6=B0=E1=BB=9Di =C4=91ang gi=E1=BB=AF phi=E1=BA=BFu.</li=
>
</ul>
<h4 class=3D"code-line" style=3D"" data-line=3D"21" id=3D"id-=E2=9C=85CS1.E=
5.US04:[C=E1=BA=A5pNL]Ti=E1=BA=BFpnh=E1=BA=ADnv=C3=A0Quy=E1=BA=BFt=C4=91=E1=
=BB=8Bnhsauchuy=E1=BB=83nch=E1=BA=BF-AC2:T=C3=A1chd=C3=B2ng&amp;Nh=E1=BA=AD=
pk=E1=BA=BFtqu=E1=BA=A3=C4=91oph=E1=BB=95(Multi-rowInbound)">AC 2: T=C3=A1c=
h d=C3=B2ng &amp; Nh=E1=BA=ADp k=E1=BA=BFt qu=E1=BA=A3 =C4=91o ph=E1=BB=95 =
(Multi-row Inbound)</h4>
<ul class=3D"code-line" style=3D"" data-line=3D"23">
 <li class=3D"code-line" data-line=3D"23" data-uuid=3D"7f785b60-fbfd-46c0-b=
21b-02326d70e421"><strong>Given:</strong><span>&nbsp;</span>M=E1=BA=BB chuy=
=E1=BB=83n ch=E1=BA=BF c=C3=B3 th=E1=BB=83 cho ra nhi=E1=BB=81u c=E1=BB=A5c=
/th=E1=BB=8Fi v=C3=A0ng/h=E1=BB=99i kh=C3=A1c nhau.</li>
 <li class=3D"code-line" data-line=3D"24" data-uuid=3D"5f89fbce-0769-40c9-b=
888-3ac1a72870ff"><strong>When:</strong><span>&nbsp;</span>Ng=C6=B0=E1=BB=
=9Di d=C3=B9ng nh=E1=BA=A5n "Th=C3=AAm d=C3=B2ng" v=C3=A0 nh=E1=BA=ADp c=C3=
=A1c ch=E1=BB=89 s=E1=BB=91 XRF (% Au, % Ag, % Cu...) c=C3=B9ng v=E1=BB=9Bi=
 Tr=E1=BB=8Dng l=C6=B0=E1=BB=A3ng sau =C4=91o.</li>
 <li class=3D"code-line" data-line=3D"25" data-uuid=3D"80a63263-2ddd-43c8-8=
8a5-83398118da8c"><strong>Then:</strong><span>&nbsp;</span>H=E1=BB=87 th=E1=
=BB=91ng cho ph=C3=A9p khai b=C3=A1o =C4=91=E1=BB=99c l=E1=BA=ADp t=E1=BB=
=ABng d=C3=B2ng v=C3=A0 t=E1=BB=B1 =C4=91=E1=BB=99ng t=C3=ADnh Tu=E1=BB=95i=
 (Purity), Quy 99.99 d=E1=BB=B1a tr=C3=AAn =C4=91=E1=BA=B7c t=C3=ADnh Lo=E1=
=BA=A1i NL. Hao h=E1=BB=A5t c=E1=BB=A7a m=E1=BA=BB s=E1=BA=BD =C4=91=C6=B0=
=E1=BB=A3c t=C3=ADnh t=E1=BB=95ng =3D (T=E1=BB=95ng TL In) - (T=E1=BB=95ng =
TL th=E1=BB=B1c nh=E1=BA=ADn).</li>
</ul>
<h4 class=3D"code-line" style=3D"" data-line=3D"27" id=3D"id-=E2=9C=85CS1.E=
5.US04:[C=E1=BA=A5pNL]Ti=E1=BA=BFpnh=E1=BA=ADnv=C3=A0Quy=E1=BA=BFt=C4=91=E1=
=BB=8Bnhsauchuy=E1=BB=83nch=E1=BA=BF-AC3:Quy=E1=BA=BFt=C4=91=E1=BB=8BnhNh=
=E1=BA=ADpKho">AC 3: Quy=E1=BA=BFt =C4=91=E1=BB=8Bnh Nh=E1=BA=ADp Kho</h4>
<ul class=3D"code-line" style=3D"" data-line=3D"28">
 <li class=3D"code-line" data-line=3D"28" data-uuid=3D"d544afe0-f775-4b51-9=
271-66e5590df627"><strong>Given:</strong><span>&nbsp;</span>Ng=C6=B0=E1=BB=
=9Di d=C3=B9ng =C4=91=C3=A3 ho=C3=A0n t=E1=BA=A5t vi=E1=BB=87c nh=E1=BA=ADp=
 k=E1=BA=BFt qu=E1=BA=A3.</li>
 <li class=3D"code-line" data-line=3D"29" data-uuid=3D"6fbece06-ee94-44a6-8=
0b2-f8d0641f1b34"><strong>When:</strong><span>&nbsp;</span>Ng=C6=B0=E1=BB=
=9Di d=C3=B9ng ch=E1=BB=8Dn "Nh=E1=BA=ADp Kho" cho to=C3=A0n b=E1=BB=99 m=
=E1=BA=BB (v=C3=A0 c=C3=B3 th=E1=BB=83 check In nh=C3=A3n NL).</li>
 <li class=3D"code-line" data-line=3D"30" data-uuid=3D"bac4a3fe-adab-40cb-8=
9d0-7aeb7580c9ac"><strong>Then:</strong><span>&nbsp;</span>H=E1=BB=87 th=E1=
=BB=91ng th=E1=BB=B1c hi=E1=BB=87n ch=E1=BB=91t s=E1=BB=91 li=E1=BB=87u, si=
nh m=C3=A3 L=C3=B4 m=E1=BB=9Bi (Lot Tracking Serial ID) cho t=E1=BB=ABng d=
=C3=B2ng, =C4=91=C3=A1nh tr=E1=BA=A1ng th=C3=A1i L=C3=B4 th=C3=A0nh "NL =C4=
=90=C3=BAc Cast" ho=E1=BA=B7c "NL =C4=90=C3=BAc HTJ", t=C4=83ng t=E1=BB=93n=
 Kho NL v=C3=A0 k=E1=BA=BFt th=C3=BAc Conversion Order.</li>
</ul>
<h4 class=3D"code-line" style=3D"" data-line=3D"32" id=3D"id-=E2=9C=85CS1.E=
5.US04:[C=E1=BA=A5pNL]Ti=E1=BA=BFpnh=E1=BA=ADnv=C3=A0Quy=E1=BA=BFt=C4=91=E1=
=BB=8Bnhsauchuy=E1=BB=83nch=E1=BA=BF-AC4:Quy=E1=BA=BFt=C4=91=E1=BB=8BnhC=E1=
=BA=A5pth=E1=BA=B3ngchoY=C3=AAuc=E1=BA=A7u(Pass-through)">AC 4: Quy=E1=BA=
=BFt =C4=91=E1=BB=8Bnh C=E1=BA=A5p th=E1=BA=B3ng cho Y=C3=AAu c=E1=BA=A7u (=
Pass-through)</h4>
<ul class=3D"code-line" style=3D"" data-line=3D"33">
 <li class=3D"code-line" data-line=3D"33" data-uuid=3D"fce2420e-51bd-4053-b=
aa2-5a0583392a01"><strong>Given:</strong><span>&nbsp;</span>Conversion Orde=
r c=C3=B3 li=C3=AAn k=E1=BA=BFt v=E1=BB=9Bi m=E1=BB=99t Casting Order =C4=
=91ang ch=E1=BB=9D v=C3=A0 t=E1=BB=95ng TL th=E1=BB=B1c nh=E1=BA=ADn c=E1=
=BB=A7a to=C3=A0n b=E1=BB=99 m=E1=BA=BB =C4=91=C3=A1p =E1=BB=A9ng =C4=91=E1=
=BB=A7 =C4=91=E1=BB=8Bnh m=E1=BB=A9c y=C3=AAu c=E1=BA=A7u.</li>
 <li class=3D"code-line" data-line=3D"34" data-uuid=3D"b99085ab-e1c7-4312-a=
b6d-6ef60b2f1791"><strong>When:</strong><span>&nbsp;</span>Ng=C6=B0=E1=BB=
=9Di d=C3=B9ng ch=E1=BB=8Dn "C=E1=BA=A5p cho Y=C3=AAu c=E1=BA=A7u".</li>
 <li class=3D"code-line" data-line=3D"35" data-uuid=3D"50c64790-3ec3-4027-b=
099-a629008dd839"><strong>Then:</strong><span>&nbsp;</span>H=E1=BB=87 th=E1=
=BB=91ng sinh L=C3=B4 m=E1=BB=9Bi v=C3=A0<span>&nbsp;</span><strong>t=E1=BB=
=B1 =C4=91=E1=BB=99ng t=E1=BA=A1o ngay "Phi=E1=BA=BFu Xu=E1=BA=A5t C=E1=BA=
=A5p"</strong><span>&nbsp;</span>chuy=E1=BB=83n cho Casting Order =C4=91=C3=
=B3 m=C3=A0 kh=C3=B4ng c=E1=BA=A7n nh=E1=BA=ADp kho ch=E1=BB=9D. Tr=E1=BA=
=A1ng th=C3=A1i Casting Order =C4=91=E1=BB=95i th=C3=A0nh "=C4=90ang s=E1=
