pan>&nbsp;</span><strong>Actor:</strong><span>&nbsp;</span>Tr=C6=B0=E1=BB=
=9Fng b=E1=BB=99 ph=E1=BA=ADn Material Control (TBP MC) / Qu=E1=BA=A3n l=C3=
=BD Kho NL</p>
<h2 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E2.US02:[Nh=E1=BA=ADnV=E1=BB=
=A5n]Thi=E1=BA=BFtl=E1=BA=ADpkhom=E1=BA=B7c=C4=91=E1=BB=8Bnhnh=E1=BA=ADpv=
=E1=BB=A5n-1.USERSTORY">1. USER STORY</h2>
<ul class=3D"code-line">
 <li class=3D"code-line" data-uuid=3D"afda3daa-3c6a-4ddb-89d9-cdf110abb633"=
><strong>L=C3=A0 m=E1=BB=99t (As a):</strong><span>&nbsp;</span>Tr=C6=B0=E1=
=BB=9Fng b=E1=BB=99 ph=E1=BA=ADn / Qu=E1=BA=A3n l=C3=BD Kho NL</li>
 <li class=3D"code-line" data-uuid=3D"d5ccb179-0df8-4132-b121-b794e5750950"=
><strong>T=C3=B4i mu=E1=BB=91n (I want):</strong><span>&nbsp;</span>C=E1=BA=
=A5u h=C3=ACnh thi=E1=BA=BFt l=E1=BA=ADp Nh=C3=A0 kho (Sub-warehouse) m=E1=
=BA=B7c =C4=91=E1=BB=8Bnh d=C3=B9ng cho lu=E1=BB=93ng Ti=E1=BA=BFp nh=E1=BA=
=ADn V=E1=BB=A5n t=E1=BB=AB =C4=90i=E1=BB=81u Ph=E1=BB=91i.</li>
 <li class=3D"code-line" data-uuid=3D"ecbd7597-33c9-4911-883b-5f86c4ab21ec"=
><strong>=C4=90=E1=BB=83 (So that):</strong><span>&nbsp;</span>H=E1=BB=87 t=
h=E1=BB=91ng c=C3=B3 th=E1=BB=83 t=E1=BB=B1 =C4=91=E1=BB=99ng =C4=91i=E1=BB=
=81n (auto-suggest) gi=C3=A1 tr=E1=BB=8B n=C3=A0y v=C3=A0o Form Nh=E1=BA=AD=
p kho khi nh=C3=A2n vi=C3=AAn b=E1=BA=A5m "Nh=E1=BA=ADn" v=E1=BB=A5n, gi=C3=
=BAp thao t=C3=A1c nhanh ch=C3=B3ng v=C3=A0 gi=E1=BA=A3m thi=E1=BB=83u sai =
s=C3=B3t do ch=E1=BB=8Dn nh=E1=BA=A7m kho.</li>
</ul>
<hr class=3D"code-line">
<h2 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E2.US02:[Nh=E1=BA=ADnV=E1=BB=
