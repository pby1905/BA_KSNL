h=E1=BA=ADnv=E1=BB=A5n">AC 1: L=C6=B0u c=E1=BA=A5u h=C3=ACnh kho m=E1=BA=B7=
c =C4=91=E1=BB=8Bnh nh=E1=BA=ADn v=E1=BB=A5n</h3>
<ul class=3D"code-line">
 <li class=3D"code-line" data-uuid=3D"78657b51-f2cf-454c-a578-52d800dc90fa"=
><strong>Given:</strong><span>&nbsp;</span>Ng=C6=B0=E1=BB=9Di d=C3=B9ng c=
=C3=B3 quy=E1=BB=81n truy c=E1=BA=ADp m=C3=A0n h=C3=ACnh C=E1=BA=A5u h=C3=
=ACnh h=E1=BB=87 th=E1=BB=91ng -&gt; tab "Ti=E1=BA=BFp nh=E1=BA=ADn V=E1=BB=
=A5n".</li>
 <li class=3D"code-line" data-uuid=3D"0f43a8f8-fd79-4bf9-92b0-a65cee59967b"=
><strong>When:</strong><span>&nbsp;</span>H=E1=BB=87 th=E1=BB=91ng t=E1=BA=
=A3i d=E1=BB=AF li=E1=BB=87u c=E1=BA=A5u h=C3=ACnh hi=E1=BB=87n t=E1=BA=A1i=
 (n=E1=BA=BFu c=C3=B3).</li>
 <li class=3D"code-line" data-uuid=3D"ad5f54c4-97d4-469e-be7c-73fab0cc60ad"=
><strong>And:</strong><span>&nbsp;</span>Ng=C6=B0=E1=BB=9Di d=C3=B9ng thay =
=C4=91=E1=BB=95i Dropdown cho tr=C6=B0=E1=BB=9Dng:<span>&nbsp;</span><stron=
g>Kho Nh=E1=BA=ADp V=E1=BB=A5n</strong>.</li>
 <li class=3D"code-line" data-uuid=3D"77e542b2-71d3-41ff-b985-9d985bb388bf"=
><strong>And:</strong><span>&nbsp;</span>Nh=E1=BA=A5n "L=C6=B0u c=E1=BA=A5u=
 h=C3=ACnh".</li>
 <li class=3D"code-line" data-uuid=3D"fa0599c7-6db1-424f-b663-83ec06b0dfed"=
><strong>Then:</strong><span>&nbsp;</span>H=E1=BB=87 th=E1=BB=91ng b=C3=A1o=
 l=C6=B0u th=C3=A0nh c=C3=B4ng v=C3=A0 c=E1=BA=ADp nh=E1=BA=ADt c=E1=BA=A5u=
 h=C3=ACnh n=C3=A0y cho to=C3=A0n h=E1=BB=87 th=E1=BB=91ng (Global Config).=
</li>
</ul>
<h3 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E2.US02:[Nh=E1=BA=ADnV=E1=BB=
