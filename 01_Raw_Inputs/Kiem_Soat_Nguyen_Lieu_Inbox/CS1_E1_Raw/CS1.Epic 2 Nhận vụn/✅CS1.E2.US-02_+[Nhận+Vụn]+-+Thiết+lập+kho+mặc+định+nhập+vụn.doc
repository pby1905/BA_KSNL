=ACnhv=C3=A0oFormNh=E1=BA=ADpKho">AC 2: T=E1=BB=B1 =C4=91=E1=BB=99ng =C4=91=
i=E1=BB=81n c=E1=BA=A5u h=C3=ACnh v=C3=A0o Form Nh=E1=BA=ADp Kho</h3>
<ul class=3D"code-line">
 <li class=3D"code-line" data-uuid=3D"89861a86-dd4b-4520-8ee8-3ca96badbfe8"=
><strong>Given:</strong><span>&nbsp;</span>=C4=90=C3=A3 c=C3=B3 c=E1=BA=A5u=
 h=C3=ACnh m=E1=BA=B7c =C4=91=E1=BB=8Bnh (Active).</li>
 <li class=3D"code-line" data-uuid=3D"b86e025e-8ba5-48da-ba73-ded16f1936af"=
><strong>When:</strong><span>&nbsp;</span>Nh=C3=A2n vi=C3=AAn Kho NL thao t=
=C3=A1c b=E1=BA=A5m n=C3=BAt<span>&nbsp;</span><code>[ Nh=E1=BA=ADn ]</code=
><span>&nbsp;</span>tr=C3=AAn m=E1=BB=99t Phi=E1=BA=BFu chuy=E1=BB=83n V=E1=
=BB=A5n (US-03).</li>
 <li class=3D"code-line" data-uuid=3D"d4b2c53a-0b54-4418-b7db-8019e10ee2aa"=
><strong>Then:</strong><span>&nbsp;</span>Tr=C3=AAn Modal "Nh=E1=BA=ADp kho=
", tr=C6=B0=E1=BB=9Dng UI "Nh=C3=A0 kho" t=E1=BB=B1 =C4=91=E1=BB=99ng =C4=
=91=C6=B0=E1=BB=A3c =C4=91i=E1=BB=81n s=E1=BA=B5n gi=C3=A1 tr=E1=BB=8B l=E1=
=BA=A5y t=E1=BB=AB b=E1=BA=A3ng c=E1=BA=A5u h=C3=ACnh v=E1=BB=ABa t=E1=BA=
=A1o.</li>
 <li class=3D"code-line" data-uuid=3D"99ffac39-3e76-4cd7-9abb-7c022bbfcdad"=
><strong>And:</strong><span>&nbsp;</span>Ng=C6=B0=E1=BB=9Di d=C3=B9ng v=E1=
=BA=ABn c=C3=B3 quy=E1=BB=81n manual (ch=E1=BB=8Dn th=E1=BB=A7 c=C3=B4ng) l=
=E1=BA=A1i kho kh=C3=A1c n=E1=BA=BFu mu=E1=BB=91n.</li>
</ul>
