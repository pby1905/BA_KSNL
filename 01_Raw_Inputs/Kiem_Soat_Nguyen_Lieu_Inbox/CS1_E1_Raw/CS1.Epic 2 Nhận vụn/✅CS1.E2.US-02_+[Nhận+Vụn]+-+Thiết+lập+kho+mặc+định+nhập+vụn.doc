C)">2. TI=C3=8AU CH=C3=8D CH=E1=BA=A4P NH=E1=BA=ACN (ACCEPTANCE CRITERIA - =
AC)</h2>
<h3 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E2.US02:[Nh=E1=BA=ADnV=E1=BB=
=A5n]Thi=E1=BA=BFtl=E1=BA=ADpkhom=E1=BA=B7c=C4=91=E1=BB=8Bnhnh=E1=BA=ADpv=
