=ACnh m=E1=BA=B7c =C4=91=E1=BB=8Bnh b=E1=BB=8B "Deactivate" trong Master Da=
ta, h=E1=BB=87 th=E1=BB=91ng s=E1=BA=BD b=E1=BB=8F qua (fallback v=E1=BB=81=
 NULL) v=C3=A0 nh=C3=A2n vi=C3=AAn ph=E1=BA=A3i t=E1=BB=B1 ch=E1=BB=8Dn Kho=
 khi l=C3=A0m nghi=E1=BB=87p v=E1=BB=A5 Nh=E1=BA=ADp kho V=E1=BB=A5n.</li>
</ul>
