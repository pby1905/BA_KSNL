    <h1>=E2=9C=85CS1.E2.US-03: [Nh=E1=BA=ADn V=E1=BB=A5n] - Ki=E1=BB=83m tr=
a tr=E1=BB=8Dng l=C6=B0=E1=BB=A3ng chi ti=E1=BA=BFt &amp; X=C3=A1c nh=E1=BA=
=ADn/T=E1=BB=AB ch=E1=BB=91i</h1>
    <div class=3D"Section1">
        <p class=3D"code-line"><strong>Epic:</strong><span>&nbsp;</span>Nh=
=E1=BA=ADn V=E1=BB=A5n t=E1=BB=AB =C4=90i=E1=BB=81u Ph=E1=BB=91i (CS1.E2)<s=
pan>&nbsp;</span><strong>Actor:</strong><span>&nbsp;</span>Nh=C3=A2n vi=C3=
=AAn Kho NL</p>
<h2 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E2.US03:[Nh=E1=BA=ADnV=E1=BB=
=A5n]Ki=E1=BB=83mtratr=E1=BB=8Dngl=C6=B0=E1=BB=A3ngchiti=E1=BA=BFt&amp;X=C3=
=A1cnh=E1=BA=ADn/T=E1=BB=ABch=E1=BB=91i-1.USERSTORY">1. USER STORY</h2>
<ul class=3D"code-line">
 <li class=3D"code-line" data-uuid=3D"daf7f35a-aa2e-44fe-aae7-489e78328364"=
><strong>L=C3=A0 m=E1=BB=99t (As a):</strong><span>&nbsp;</span>Nh=C3=A2n v=
i=C3=AAn Kho NL.</li>
 <li class=3D"code-line" data-uuid=3D"11f9d3eb-ffb6-4040-b634-621a3a1de73b"=
><strong>T=C3=B4i mu=E1=BB=91n (I want):</strong><span>&nbsp;</span>Xem chi=
 ti=E1=BA=BFt t=E1=BB=ABng M=C3=A3 Item trong Phi=E1=BA=BFu chuy=E1=BB=83n =
V=E1=BB=A5n v=C3=A0 th=E1=BB=B1c hi=E1=BB=87n X=C3=A1c nh=E1=BA=ADn nh=E1=
=BA=ADn (Accept) ho=E1=BA=B7c T=E1=BB=AB ch=E1=BB=91i (Reject) =C4=91=E1=BB=
=99c l=E1=BA=ADp cho t=E1=BB=ABng m=C3=A3 m=C3=A0 kh=C3=B4ng c=E1=BA=A7n c=
=C3=A2n l=E1=BA=A1i.</li>
 <li class=3D"code-line" data-uuid=3D"b6c36fd0-990a-4f97-8653-7c161cf05d1f"=
><strong>=C4=90=E1=BB=83 (So that):</strong><span>&nbsp;</span>Thao t=C3=A1=
c ti=E1=BA=BFp nh=E1=BA=ADn v=E1=BB=A5n n=E1=BB=99i b=E1=BB=99 di=E1=BB=85n=
 ra nhanh ch=C3=B3ng, ghi t=C4=83ng t=E1=BB=93n kho d=E1=BB=B1a tr=C3=AAn t=
r=E1=BB=8Dng l=C6=B0=E1=BB=A3ng =C4=90i=E1=BB=81u Ph=E1=BB=91i (MC) =C4=91=
=C3=A3 b=C3=A1o ho=E1=BA=B7c ho=C3=A0n tr=E1=BA=A3 l=E1=BA=A1i nguy=C3=AAn =
v=E1=BA=B9n n=E1=BA=BFu t=E1=BB=AB ch=E1=BB=91i.</li>
</ul>
<hr class=3D"code-line">
<h2 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E2.US03:[Nh=E1=BA=ADnV=E1=BB=
=A5n]Ki=E1=BB=83mtratr=E1=BB=8Dngl=C6=B0=E1=BB=A3ngchiti=E1=BA=BFt&amp;X=C3=
=A1cnh=E1=BA=ADn/T=E1=BB=ABch=E1=BB=91i-2.TI=C3=8AUCH=C3=8DCH=E1=BA=A4PNH=
=E1=BA=ACN(ACCEPTANCECRITERIA-AC)">2. TI=C3=8AU CH=C3=8D CH=E1=BA=A4P NH=E1=
=BA=ACN (ACCEPTANCE CRITERIA - AC)</h2>
<h3 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E2.US03:[Nh=E1=BA=ADnV=E1=BB=
=A5n]Ki=E1=BB=83mtratr=E1=BB=8Dngl=C6=B0=E1=BB=A3ngchiti=E1=BA=BFt&amp;X=C3=
=A1cnh=E1=BA=ADn/T=E1=BB=ABch=E1=BB=91i-AC1:Hi=E1=BB=83nth=E1=BB=8Bchiti=E1=
=BA=BFtPhi=E1=BA=BFuchuy=E1=BB=83n">AC 1: Hi=E1=BB=83n th=E1=BB=8B chi ti=
=E1=BA=BFt Phi=E1=BA=BFu chuy=E1=BB=83n</h3>
<ul class=3D"code-line">
 <li class=3D"code-line" data-uuid=3D"605dcede-b0fc-436b-8964-491ce54ca4bf"=
><strong>Given:</strong><span>&nbsp;</span>Ng=C6=B0=E1=BB=9Di d=C3=B9ng cli=
ck v=C3=A0o m=E1=BB=99t Phi=E1=BA=BFu chuy=E1=BB=83n t=E1=BB=AB danh s=C3=
=A1ch ch=E1=BB=9D nh=E1=BA=ADn (US-01).</li>
 <li class=3D"code-line" data-uuid=3D"51b83ea3-5fcd-4533-af8a-9955c1395d2d"=
><strong>When:</strong><span>&nbsp;</span>M=C3=A0n h=C3=ACnh Chi ti=E1=BA=
=BFt Phi=E1=BA=BFu chuy=E1=BB=83n =C4=91=C6=B0=E1=BB=A3c m=E1=BB=9F ra.</li=
>
 <li class=3D"code-line" data-uuid=3D"9f1f7d20-b8d2-47cc-875d-d0a77defd98b"=
><strong>Then:</strong><span>&nbsp;</span>Hi=E1=BB=83n th=E1=BB=8B th=C3=B4=
ng tin chung c=E1=BB=A7a Phi=E1=BA=BFu (M=C3=A3 GD, Ng=C6=B0=E1=BB=9Di g=E1=
=BB=ADi, Ghi ch=C3=BA c=E1=BB=A7a MC).</li>
 <li class=3D"code-line" data-uuid=3D"322b0ef7-4255-4934-9333-cc16a68c6592"=
><strong>And:</strong><span>&nbsp;</span>Hi=E1=BB=83n th=E1=BB=8B danh s=C3=
=A1ch c=C3=A1c M=C3=A3 Item trong phi=E1=BA=BFu g=E1=BB=93m: M=C3=A3 Item, =
Tu=E1=BB=95i, Tr=E1=BB=8Dng l=C6=B0=E1=BB=A3ng chuy=E1=BB=83n (MC b=C3=A1o)=
.</li>
</ul>
<h3 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E2.US03:[Nh=E1=BA=ADnV=E1=BB=
=A5n]Ki=E1=BB=83mtratr=E1=BB=8Dngl=C6=B0=E1=BB=A3ngchiti=E1=BA=BFt&amp;X=C3=
=A1cnh=E1=BA=ADn/T=E1=BB=ABch=E1=BB=91i-AC2:=C4=90oph=E1=BB=95(T=C3=B9ych=
=E1=BB=8Dntr=C6=B0=E1=BB=9BckhiNh=E1=BA=ADpkho)">AC 2: =C4=90o ph=E1=BB=95 =
(T=C3=B9y ch=E1=BB=8Dn tr=C6=B0=E1=BB=9Bc khi Nh=E1=BA=ADp kho)</h3>
<ul class=3D"code-line">
 <li class=3D"code-line" data-uuid=3D"745fe964-c6f8-4030-a780-0086a206f69a"=
><strong>Given:</strong><span>&nbsp;</span>Ng=C6=B0=E1=BB=9Di d=C3=B9ng =C4=
=91ang xem danh s=C3=A1ch c=C3=A1c M=C3=A3 Item trong phi=E1=BA=BFu.</li>
 <li class=3D"code-line" data-uuid=3D"4b81b25b-daf4-49b3-872b-c724a9e297ac"=
><strong>When:</strong><span>&nbsp;</span>Ng=C6=B0=E1=BB=9Di d=C3=B9ng b=E1=
=BA=A5m n=C3=BAt<span>&nbsp;</span><code>[ =C4=90o ph=E1=BB=95 ]</code><spa=
n>&nbsp;</span>tr=C3=AAn d=C3=B2ng Item t=C6=B0=C6=A1ng =E1=BB=A9ng.</li>
 <li class=3D"code-line" data-uuid=3D"90697fff-f7c0-4dba-aa8e-90cef74a2a3a"=
><strong>Then:</strong><span>&nbsp;</span>H=E1=BB=87 th=E1=BB=91ng m=E1=BB=
=9F<span>&nbsp;</span><strong>Modal =C4=90o ph=E1=BB=95</strong><span>&nbsp=
;</span>(t=C6=B0=C6=A1ng t=E1=BB=B1 nh=C6=B0 quy tr=C3=ACnh XRF =E1=BB=9F C=
S1) v=E1=BB=9Bi c=C3=A1c tr=C6=B0=E1=BB=9Dng d=E1=BB=AF li=E1=BB=87u: Tu=E1=
=BB=95i sau =C4=91o, Tr=E1=BB=8Dng l=C6=B0=E1=BB=A3ng sau =C4=91o, c=C3=A1c=
 % th=C3=A0nh ph=E1=BA=A7n kim lo=E1=BA=A1i.</li>
 <li class=3D"code-line" data-uuid=3D"2a81c1a5-afba-4e94-8234-4ec13292abee"=
><strong>And:</strong><span>&nbsp;</span>Sau khi ng=C6=B0=E1=BB=9Di d=C3=B9=
ng =C4=91i=E1=BB=81n v=C3=A0<span>&nbsp;</span><code>[ X=C3=A1c nh=E1=BA=AD=
n L=C6=B0u ]</code>, h=E1=BB=87 th=E1=BB=91ng c=E1=BA=ADp nh=E1=BA=ADt k=E1=
=BA=BFt qu=E1=BA=A3 =C4=91o ph=E1=BB=95 cho Item n=C3=A0y (ghi nh=E1=BA=ADn=
 Tr=E1=BB=8Dng l=C6=B0=E1=BB=A3ng sau =C4=91o v=C3=A0 Tu=E1=BB=95i sau =C4=
=91o) =C4=91=E1=BB=83 l=C3=A0m c=C6=A1 s=E1=BB=9F ghi t=E1=BB=93n khi Nh=E1=
=BA=ADp kho.</li>
</ul>
<h3 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E2.US03:[Nh=E1=BA=ADnV=E1=BB=
=A5n]Ki=E1=BB=83mtratr=E1=BB=8Dngl=C6=B0=E1=BB=A3ngchiti=E1=BA=BFt&amp;X=C3=
=A1cnh=E1=BA=ADn/T=E1=BB=ABch=E1=BB=91i-AC3:M=E1=BB=9FModalNh=E1=BA=ADpkhov=
=C3=A0Ch=E1=BB=8Dnth=C3=B4ngtinl=C6=B0utr=E1=BB=AF">AC 3: M=E1=BB=9F Modal =
Nh=E1=BA=ADp kho v=C3=A0 Ch=E1=BB=8Dn th=C3=B4ng tin l=C6=B0u tr=E1=BB=AF</=
h3>
<ul class=3D"code-line">
 <li class=3D"code-line" data-uuid=3D"150ae83a-cade-455e-8497-24e5010fffae"=
><strong>Given:</strong><span>&nbsp;</span>Ng=C6=B0=E1=BB=9Di d=C3=B9ng =C4=
=91ang xem danh s=C3=A1ch c=C3=A1c M=C3=A3 Item trong phi=E1=BA=BFu.</li>
 <li class=3D"code-line" data-uuid=3D"f930de6b-0387-42f7-9f7a-85f8d5b72c51"=
><strong>When:</strong><span>&nbsp;</span>Ng=C6=B0=E1=BB=9Di d=C3=B9ng b=E1=
=BA=A5m n=C3=BAt<span>&nbsp;</span><code>[ Nh=E1=BA=ADn ]</code><span>&nbsp=
;</span>tr=C3=AAn m=E1=BB=99t d=C3=B2ng Item (ho=E1=BA=B7c tick ch=E1=BB=8D=
n nhi=E1=BB=81u d=C3=B2ng v=C3=A0 b=E1=BA=A5m X=C3=A1c nh=E1=BA=ADn h=C3=A0=
ng lo=E1=BA=A1t).</li>
 <li class=3D"code-line" data-uuid=3D"2b25a525-6d63-4df5-b42d-73fa26d0fb33"=
><strong>Then:</strong><span>&nbsp;</span>H=E1=BB=87 th=E1=BB=91ng m=E1=BB=
=9F ra<span>&nbsp;</span><strong>Modal Nh=E1=BA=ADp Kho</strong>.</li>
 <li class=3D"code-line" data-uuid=3D"c631f1ad-66c3-4a39-afbf-babed84fa99b"=
><strong>And:</strong><span>&nbsp;</span>Modal hi=E1=BB=83n th=E1=BB=8B th=
=C3=B4ng tin chi ti=E1=BA=BFt c=E1=BB=A7a t=E1=BB=ABng Item bao g=E1=BB=93m=
 c=C3=A1c tr=C6=B0=E1=BB=9Dng: Item, Tu=E1=BB=95i, SL, Chi=E1=BB=81u d=C3=
=A0i, T=E1=BB=95ng TL, TL =C4=91=C3=A1, TL, Quy 99.99, Ph=C6=B0=C6=A1ng th=
=E1=BB=A9c qu=E1=BA=A3n l=C3=BD t=E1=BB=93n.</li>
 <li class=3D"code-line" data-uuid=3D"f11a41af-b1fd-4e8c-9bcf-80a245b0fc52"=
><strong>And:</strong><span>&nbsp;</span>Modal cho ph=C3=A9p ng=C6=B0=E1=BB=
=9Di d=C3=B9ng C=E1=BA=ACP NH=E1=BA=ACT c=C3=A1c th=C3=B4ng tin l=C6=B0u tr=
=E1=BB=AF =E1=BB=9F t=E1=BB=ABng d=C3=B2ng Item:<span>&nbsp;</span><strong>=
Kho</strong>,<span>&nbsp;</span><strong>Khu v=E1=BB=B1c</strong>,<span>&nbs=
p;</span><strong>V=E1=BB=8B tr=C3=AD</strong>,<span>&nbsp;</span><strong>T=
=C3=ACnh tr=E1=BA=A1ng</strong>,<span>&nbsp;</span><strong>M=C3=A0u</strong=
>.</li>
 <li class=3D"code-line" data-uuid=3D"887c4ca6-a50a-4959-876d-8f9f613f3c06"=
><strong>And:</strong><span>&nbsp;</span>H=E1=BB=87 th=E1=BB=91ng t=E1=BB=
=B1 =C4=91=E1=BB=99ng =C4=91i=E1=BB=81n s=E1=BA=B5n (Auto-suggest) cho c=C3=
=A1c c=E1=BB=99t: Kho (l=E1=BA=A5y t=E1=BB=AB c=E1=BA=A5u h=C3=ACnh =E1=BB=
=9F US-02), Khu v=E1=BB=B1c (m=E1=BA=B7c =C4=91=E1=BB=8Bnh WIP), V=E1=BB=8B=
 tr=C3=AD (m=E1=BA=B7c =C4=91=E1=BB=8Bnh WIP). Ng=C6=B0=E1=BB=9Di d=C3=B9ng=
 c=C3=B3 quy=E1=BB=81n thay =C4=91=E1=BB=95i c=C3=A1c gi=C3=A1 tr=E1=BB=8B =
n=C3=A0y tr=C3=AAn t=E1=BB=ABng d=C3=B2ng.</li>
 <li class=3D"code-line" data-uuid=3D"33a67d6c-b42f-4ad1-b745-eb8211286800"=
><strong>And:</strong><span>&nbsp;</span>Modal KH=C3=94NG c=E1=BA=A7n y=C3=
=AAu c=E1=BA=A7u nh=E1=BA=ADp l=E1=BA=A1i tr=E1=BB=8Dng l=C6=B0=E1=BB=A3ng =
(H=E1=BB=87 th=E1=BB=91ng l=E1=BA=A5y t=E1=BB=B1 =C4=91=E1=BB=99ng d=E1=BB=
=B1a theo k=E1=BA=BFt qu=E1=BA=A3 =C4=90o ph=E1=BB=95 ho=E1=BA=B7c Tr=E1=BB=
=8Dng l=C6=B0=E1=BB=A3ng MC b=C3=A1o cho c=C3=A1c c=E1=BB=99t T=E1=BB=95ng =
