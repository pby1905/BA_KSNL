    <h1>=E2=9C=85CS1.E4.US-04: [X=E1=BB=AD l=C3=BD NL] - T=E1=BA=A1o m=E1=
=BB=9Bi Refining Order</h1>
    <div class=3D"Section1">
        <p class=3D"code-line"><strong>Epic:</strong><span>&nbsp;</span>X=
=E1=BB=AD l=C3=BD NL (CS1.E4)<span>&nbsp;</span><strong>Actor:</strong><spa=
n>&nbsp;</span>Nh=C3=A2n vi=C3=AAn Kho NL</p>
<h2 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E4.US04:[X=E1=BB=ADl=C3=BDNL]=
T=E1=BA=A1om=E1=BB=9BiRefiningOrder-1.USERSTORY">1. USER STORY</h2>
<ul class=3D"code-line">
 <li class=3D"code-line" data-uuid=3D"d4fc9341-eca2-4743-9854-b5bfdcaba75c"=
><strong>L=C3=A0 m=E1=BB=99t (As a):</strong><span>&nbsp;</span>Nh=C3=A2n v=
i=C3=AAn Kho Nguy=C3=AAn Li=E1=BB=87u</li>
 <li class=3D"code-line" data-uuid=3D"0bc1be06-c65d-4f83-a3c6-643a1d9e9a64"=
><strong>T=C3=B4i mu=E1=BB=91n (I want):</strong><span>&nbsp;</span>T=E1=BA=
=A1o m=E1=BB=9Bi "Phi=E1=BA=BFu ph=C3=A2n kim" =C4=91=E1=BB=83 thi=E1=BA=BF=
t l=E1=BA=ADp ri=C3=AAng cho c=C3=A1c nguy=C3=AAn li=E1=BB=87u =C4=91ang ch=
=E1=BB=9D ph=C3=A2n kim.</li>
 <li class=3D"code-line" data-uuid=3D"a7dc6295-bcd2-4446-a6a6-94e4ca3c43c6"=
><strong>=C4=90=E1=BB=83 (So that):</strong><span>&nbsp;</span>T=C3=B4i c=
=C3=B3 th=E1=BB=83 b=C3=A0n giao nguy=C3=AAn li=E1=BB=87u chuy=C3=AAn bi=E1=
=BB=87t cho b=E1=BB=99 ph=E1=BA=ADn Ph=C3=A2n kim x=E1=BB=AD l=C3=BD m=C3=
=A0 kh=C3=B4ng c=E1=BA=A7n c=E1=BA=A5u h=C3=ACnh qu=C3=A1 nhi=E1=BB=81u c=
=C3=B4ng =C4=91o=E1=BA=A1n th=E1=BB=ABa.</li>
</ul>
<hr class=3D"code-line">
<h2 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E4.US04:[X=E1=BB=ADl=C3=BDNL]=
T=E1=BA=A1om=E1=BB=9BiRefiningOrder-2.TI=C3=8AUCH=C3=8DCH=E1=BA=A4PNH=E1=BA=
=ACN(ACCEPTANCECRITERIA-AC)*">2. TI=C3=8AU CH=C3=8D CH=E1=BA=A4P NH=E1=BA=
=ACN (ACCEPTANCE CRITERIA - AC) *</h2>
<h3 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E4.US04:[X=E1=BB=ADl=C3=BDNL]=
T=E1=BA=A1om=E1=BB=9BiRefiningOrder-AC1:T=E1=BA=A1om=E1=BB=9BiPhi=E1=BA=BFu=
ph=C3=A2nkim(N=C3=BAtL=C6=B0u)">AC 1: T=E1=BA=A1o m=E1=BB=9Bi Phi=E1=BA=BFu=
 ph=C3=A2n kim (N=C3=BAt L=C6=B0u)</h3>
<ul class=3D"code-line">
 <li class=3D"code-line" data-uuid=3D"c578128a-f7b4-4084-bd5b-16fff44ee3ce"=
><strong>Given (Bi=E1=BA=BFt r=E1=BA=B1ng):</strong><span>&nbsp;</span>Nh=
=C3=A2n vi=C3=AAn =C4=91ang =E1=BB=9F m=C3=A0n h=C3=ACnh t=E1=BA=A1o m=E1=
=BB=9Bi "Phi=E1=BA=BFu ph=C3=A2n kim".</li>
 <li class=3D"code-line" data-uuid=3D"80472bd9-c3d4-4f45-9206-067e5b28c2d1"=
><strong>When (Khi):</strong><span>&nbsp;</span>Nh=C3=A2n vi=C3=AAn ch=E1=
=BB=8Dn nguy=C3=AAn li=E1=BB=87u, ghi ch=C3=BA v=C3=A0 nh=E1=BA=A5n n=C3=BA=
t<span>&nbsp;</span><strong>[ L=C6=B0u ]</strong>.</li>
 <li class=3D"code-line" data-uuid=3D"6617550b-d117-4370-81c1-84c59fd9e29f"=
><strong>Then (Th=C3=AC):</strong><span>&nbsp;</span>H=E1=BB=87 th=E1=BB=91=
ng t=E1=BA=A1o phi=E1=BA=BFu th=C3=A0nh c=C3=B4ng. Phi=E1=BA=BFu =E1=BB=9F =
tr=E1=BA=A1ng th=C3=A1i<span>&nbsp;</span><code>=C4=90=C3=A3 so=E1=BA=A1n</=
code>. T=C3=ACnh tr=E1=BA=A1ng nguy=C3=AAn li=E1=BB=87u chuy=E1=BB=83n sang=
<span>&nbsp;</span><code>=C4=90ang x=E1=BB=AD l=C3=BD</code><span>&nbsp;</s=
pan>(kh=C3=B3a kh=E1=BB=8Fi kho).</li>
 <li class=3D"code-line" data-uuid=3D"53706ea1-a1a2-4ad2-99db-62ad8cbf337b"=
><strong>And (V=C3=A0):</strong><span>&nbsp;</span>N=E1=BA=BFu checkbox<spa=
n>&nbsp;</span><strong>"In phi=E1=BA=BFu"</strong><span>&nbsp;</span>=C4=91=
=C6=B0=E1=BB=A3c t=C3=ADch ch=E1=BB=8Dn, h=E1=BB=87 th=E1=BB=91ng t=E1=BB=
=B1 =C4=91=E1=BB=99ng xu=E1=BA=A5t b=E1=BA=A3n in (PDF) ngay sau khi l=C6=
=B0u th=C3=A0nh c=C3=B4ng.</li>
</ul>
<h3 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E4.US04:[X=E1=BB=ADl=C3=BDNL]=
T=E1=BA=A1om=E1=BB=9BiRefiningOrder-AC2:T=E1=BA=A1om=E1=BB=9Biv=C3=A0B=C3=
=A0ngiao(N=C3=BAtL=C6=B0uv=C3=A0Chuy=E1=BB=83n)">AC 2: T=E1=BA=A1o m=E1=BB=
=9Bi v=C3=A0 B=C3=A0n giao (N=C3=BAt L=C6=B0u v=C3=A0 Chuy=E1=BB=83n)</h3>
<ul class=3D"code-line">
 <li class=3D"code-line" data-uuid=3D"2496976c-1490-4305-bbd2-c4bd81f9f712"=
><strong>Given (Bi=E1=BA=BFt r=E1=BA=B1ng):</strong><span>&nbsp;</span>Nh=
=C3=A2n vi=C3=AAn =C4=91ang =E1=BB=9F m=C3=A0n h=C3=ACnh t=E1=BA=A1o m=E1=
=BB=9Bi "Phi=E1=BA=BFu ph=C3=A2n kim".</li>
 <li class=3D"code-line" data-uuid=3D"4e2c7e12-ecc1-487f-b8e7-8e0131b38aa0"=
><strong>When (Khi):</strong><span>&nbsp;</span>Nh=C3=A2n vi=C3=AAn nh=E1=
=BA=A5n n=C3=BAt<span>&nbsp;</span><strong>[ L=C6=B0u v=C3=A0 Chuy=E1=BB=83=
n ]</strong>.</li>
 <li class=3D"code-line" data-uuid=3D"55839662-4fae-49a6-b322-d0c61bebde8d"=
><strong>Then (Th=C3=AC):</strong><span>&nbsp;</span>H=E1=BB=87 th=E1=BB=91=
ng hi=E1=BB=83n th=E1=BB=8B Popup/Modal ch=E1=BB=8Dn<span>&nbsp;</span><str=
ong>Ng=C6=B0=E1=BB=9Di nh=E1=BA=ADn</strong><span>&nbsp;</span>(Assignee).<=
/li>
 <li class=3D"code-line" data-uuid=3D"9bd398fd-5b99-48c2-878e-50d629cb1572"=
><strong>And (V=C3=A0):</strong><span>&nbsp;</span>Sau khi ch=E1=BB=8Dn ng=
=C6=B0=E1=BB=9Di nh=E1=BA=ADn v=C3=A0 x=C3=A1c nh=E1=BA=ADn, h=E1=BB=87 th=
=E1=BB=91ng t=E1=BA=A1o phi=E1=BA=BFu th=C3=A0nh c=C3=B4ng.</li>
 <li class=3D"code-line" data-uuid=3D"4c622640-eb54-4a2b-bc40-93e85d9b10e0"=
><strong>Then (Th=C3=AC):</strong><span>&nbsp;</span>Tr=E1=BA=A1ng th=C3=A1=
i phi=E1=BA=BFu t=E1=BB=B1 =C4=91=E1=BB=99ng chuy=E1=BB=83n sang<span>&nbsp=
;</span><code>=C4=90ang x=E1=BB=AD l=C3=BD</code>. Ghi nh=E1=BA=ADn th=C3=
=B4ng tin Ng=C6=B0=E1=BB=9Di nh=E1=BA=ADn v=C3=A0o phi=E1=BA=BFu.</li>
 <li class=3D"code-line" data-uuid=3D"86767bff-02b2-4038-a9cd-85d8dc76c651"=
><strong>And (V=C3=A0):</strong><span>&nbsp;</span>N=E1=BA=BFu checkbox<spa=
n>&nbsp;</span><strong>"In phi=E1=BA=BFu"</strong><span>&nbsp;</span>=C4=91=
=C6=B0=E1=BB=A3c t=C3=ADch ch=E1=BB=8Dn, h=E1=BB=87 th=E1=BB=91ng t=E1=BB=
=B1 =C4=91=E1=BB=99ng xu=E1=BA=A5t b=E1=BA=A3n in (PDF) ngay sau khi b=C3=
=A0n giao th=C3=A0nh c=C3=B4ng.</li>
</ul>
<h3 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E4.US04:[X=E1=BB=ADl=C3=BDNL]=
T=E1=BA=A1om=E1=BB=9BiRefiningOrder-AC3:ValidateT=C3=ACnhtr=E1=BA=A1ngnguy=
=C3=AAnli=E1=BB=87u">AC 3: Validate T=C3=ACnh tr=E1=BA=A1ng nguy=C3=AAn li=
=E1=BB=87u</h3>
<ul class=3D"code-line">
 <li class=3D"code-line" data-uuid=3D"a3a83029-e1b9-433c-92d9-a9332023cf0b"=
><strong>Given (Bi=E1=BA=BFt r=E1=BA=B1ng):</strong><span>&nbsp;</span>Nh=
=C3=A2n vi=C3=AAn =C4=91ang th=C3=AAm nguy=C3=AAn li=E1=BB=87u v=C3=A0o Phi=
=E1=BA=BFu ph=C3=A2n kim.</li>
 <li class=3D"code-line" data-uuid=3D"2a77cfb8-ff4b-46a1-ad37-4085275be326"=
><strong>When (Khi):</strong><span>&nbsp;</span>Th=C3=AAm nguy=C3=AAn li=E1=
=BB=87u c=C3=B3 t=C3=ACnh tr=E1=BA=A1ng kh=C3=A1c "NL ch=E1=BB=9D ph=C3=A2n=
 kim".</li>
 <li class=3D"code-line" data-uuid=3D"953816fa-3316-4e09-98a0-24841018dc3a"=
><strong>Then (Th=C3=AC):</strong><span>&nbsp;</span>H=E1=BB=87 th=E1=BB=91=
ng ch=E1=BA=B7n h=C3=A0nh =C4=91=E1=BB=99ng, tr=E1=BB=AB tr=C6=B0=E1=BB=9Dn=
g h=E1=BB=A3p nguy=C3=AAn li=E1=BB=87u thu=E1=BB=99c<span>&nbsp;</span><str=
ong>Kho h=E1=BB=99i</strong><span>&nbsp;</span>v=C3=A0 c=C3=B3 t=C3=ACnh tr=
=E1=BA=A1ng l=C3=A0<span>&nbsp;</span><strong>"H=E1=BB=99i h=C3=A0ng ng=C3=
=A0y"</strong>.</li>
</ul>
<h3 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E4.US04:[X=E1=BB=ADl=C3=BDNL]=
T=E1=BA=A1om=E1=BB=9BiRefiningOrder-AC4:Th=C3=AAm/X=C3=B3anguy=C3=AAnli=E1=
=BB=87u(PickMaterials)">AC 4: Th=C3=AAm/X=C3=B3a nguy=C3=AAn li=E1=BB=87u (=
Pick Materials)</h3>
<ul class=3D"code-line">
 <li class=3D"code-line" data-uuid=3D"34995bd4-2d2f-4431-89e9-80610e4df555"=
><strong>Given (Bi=E1=BA=BFt r=E1=BA=B1ng):</strong><span>&nbsp;</span>Nh=
=C3=A2n vi=C3=AAn =C4=91ang =E1=BB=9F m=C3=A0n h=C3=ACnh t=E1=BA=A1o phi=E1=
=BA=BFu.</li>
 <li class=3D"code-line" data-uuid=3D"18c98d5d-895d-44f7-bad4-93694959f748"=
><strong>When (Khi):</strong><span>&nbsp;</span>Ch=E1=BB=8Dn nguy=C3=AAn li=
=E1=BB=87u t=E1=BB=AB danh s=C3=A1ch (Panel tr=C3=A1i) ho=E1=BA=B7c d=C3=B9=
ng s=C3=BAng qu=C3=A9t m=C3=A3 v=E1=BA=A1ch qu=C3=A9t "M=C3=A3 L=C3=B4".</l=
i>
 <li class=3D"code-line" data-uuid=3D"e5efa8bd-97de-4b06-b3ae-29b6f82b78f1"=
><strong>Then (Th=C3=AC):</strong><span>&nbsp;</span>C=C6=A1 ch=E1=BA=BF Sm=
art Input t=E1=BB=B1 =C4=91=E1=BB=99ng ph=C3=A2n t=C3=ADch v=C3=A0 =C4=91=
=E1=BA=A9y nguy=C3=AAn li=E1=BB=87u t=C6=B0=C6=A1ng =E1=BB=A9ng sang Panel =
ph=E1=BA=A3i (Line Items).</li>
</ul>
<h3 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E4.US04:[X=E1=BB=ADl=C3=BDNL]=
T=E1=BA=A1om=E1=BB=9BiRefiningOrder-AC5:Ch=E1=BB=89nhs=E1=BB=ADakh=E1=BB=91=
il=C6=B0=E1=BB=A3ngc=E1=BA=A7nd=C3=B9ng(TLt=E1=BB=95ng)&amp;T=C3=ADnht=E1=
=BB=95ngphi=E1=BA=BFu">AC 5: Ch=E1=BB=89nh s=E1=BB=ADa kh=E1=BB=91i l=C6=B0=
=E1=BB=A3ng c=E1=BA=A7n d=C3=B9ng (TL t=E1=BB=95ng) &amp; T=C3=ADnh t=E1=BB=
=95ng phi=E1=BA=BFu</h3>
<ul class=3D"code-line">
 <li class=3D"code-line" data-uuid=3D"3155de1c-c4bb-4094-a8b6-fc495c7af1c8"=
><strong>Given (Bi=E1=BA=BFt r=E1=BA=B1ng):</strong><span>&nbsp;</span>Nh=
=C3=A2n vi=C3=AAn =C4=91ang =E1=BB=9F Line Items.</li>
 <li class=3D"code-line" data-uuid=3D"fe724051-195b-43d1-89e9-757e17628a82"=
><strong>When (Khi):</strong><span>&nbsp;</span>Thay =C4=91=E1=BB=95i "TL t=
=E1=BB=95ng" b=E1=BA=B1ng b=C3=A0n ph=C3=ADm ho=E1=BA=B7c thi=E1=BA=BFt b=
=E1=BB=8B c=C3=A2n k=E1=BA=BFt n=E1=BB=91i cho t=E1=BB=ABng d=C3=B2ng.</li>
 <li class=3D"code-line" data-uuid=3D"0cb729d5-507d-4cf1-9f53-a83ddb199718"=
><strong>Then (Th=C3=AC):</strong>
  <ul class=3D"code-line">
   <li class=3D"code-line">T=E1=BB=B1 =C4=91=E1=BB=99ng t=C3=ADnh l=E1=BA=
=A1i TL kim lo=E1=BA=A1i v=C3=A0 Quy 99.99 t=C6=B0=C6=A1ng =E1=BB=A9ng cho =
d=C3=B2ng =C4=91=C3=B3.</li>
