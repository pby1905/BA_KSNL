. C=C3=B3 thanh Action Toolbar ho=E1=BA=B7c n=C3=BAt =E1=BB=9F t=E1=BB=ABng=
 d=C3=B2ng hi=E1=BB=83n th=E1=BB=8B thay =C4=91=E1=BB=95i linh ho=E1=BA=A1t=
 theo Tr=E1=BA=A1ng th=C3=A1i c=E1=BB=A7a phi=E1=BA=BFu.</li>
