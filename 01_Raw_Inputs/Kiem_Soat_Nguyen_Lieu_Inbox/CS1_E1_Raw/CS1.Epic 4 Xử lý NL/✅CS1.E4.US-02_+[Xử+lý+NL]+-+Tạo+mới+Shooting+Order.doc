    <h1>=E2=9C=85CS1.E4.US-02: [X=E1=BB=AD l=C3=BD NL] - T=E1=BA=A1o m=E1=
=BB=9Bi Shooting Order</h1>
    <div class=3D"Section1">
        <p class=3D"code-line"><strong>Epic:</strong><span>&nbsp;</span>X=
=E1=BB=AD l=C3=BD NL (CS1.E4)<span>&nbsp;</span><strong>Actor:</strong><spa=
n>&nbsp;</span>Nh=C3=A2n vi=C3=AAn Kho NL</p>
<h2 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E4.US02:[X=E1=BB=ADl=C3=BDNL]=
T=E1=BA=A1om=E1=BB=9BiShootingOrder-1.USERSTORY">1. USER STORY</h2>
<ul class=3D"code-line">
 <li class=3D"code-line" data-uuid=3D"3f485d58-863d-4bea-a274-a529551b4be5"=
><strong>L=C3=A0 m=E1=BB=99t (As a):</strong><span>&nbsp;</span>Nh=C3=A2n v=
i=C3=AAn Kho Nguy=C3=AAn Li=E1=BB=87u</li>
 <li class=3D"code-line" data-uuid=3D"d946e1e2-bc36-49ea-8e0b-4e0724ecbe72"=
><strong>T=C3=B4i mu=E1=BB=91n (I want):</strong><span>&nbsp;</span>T=E1=BA=
=A1o m=E1=BB=9Bi "Phi=E1=BA=BFu x=E1=BB=AD", ch=E1=BB=8Dn c=C3=A1c nguy=C3=
=AAn li=E1=BB=87u c=E1=BA=A7n x=E1=BB=AD l=C3=BD v=C3=A0 g=C3=A1n nh=C3=A3n=
 c=C3=B4ng =C4=91o=E1=BA=A1n y=C3=AAu c=E1=BA=A7u.</li>
 <li class=3D"code-line" data-uuid=3D"357e7b91-4bdd-49df-9b26-0f2d8a867d4d"=
><strong>=C4=90=E1=BB=83 (So that):</strong><span>&nbsp;</span>T=C3=B4i c=
=C3=B3 th=E1=BB=83 b=C3=A0n giao nguy=C3=AAn li=E1=BB=87u cho b=E1=BB=99 ph=
=E1=BA=ADn X=E1=BB=AD l=C3=BD l=C3=A0m vi=E1=BB=87c theo =C4=91=C3=BAng y=
=C3=AAu c=E1=BA=A7u.</li>
</ul>
<hr class=3D"code-line">
<h2 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E4.US02:[X=E1=BB=ADl=C3=BDNL]=
T=E1=BA=A1om=E1=BB=9BiShootingOrder-2.TI=C3=8AUCH=C3=8DCH=E1=BA=A4PNH=E1=BA=
=ACN(ACCEPTANCECRITERIA-AC)*">2. TI=C3=8AU CH=C3=8D CH=E1=BA=A4P NH=E1=BA=
=ACN (ACCEPTANCE CRITERIA - AC) *</h2>
<h3 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E4.US02:[X=E1=BB=ADl=C3=BDNL]=
T=E1=BA=A1om=E1=BB=9BiShootingOrder-AC1:T=E1=BA=A1om=E1=BB=9BiPhi=E1=BA=BFu=
x=E1=BB=AD(N=C3=BAtL=C6=B0u)">AC 1: T=E1=BA=A1o m=E1=BB=9Bi Phi=E1=BA=BFu x=
=E1=BB=AD (N=C3=BAt L=C6=B0u)</h3>
<ul class=3D"code-line">
 <li class=3D"code-line" data-uuid=3D"811f193b-5a39-4f05-b971-7aa3c33353b0"=
><strong>Given (Bi=E1=BA=BFt r=E1=BA=B1ng):</strong><span>&nbsp;</span>Nh=
=C3=A2n vi=C3=AAn =C4=91ang =E1=BB=9F m=C3=A0n h=C3=ACnh t=E1=BA=A1o m=E1=
=BB=9Bi "Phi=E1=BA=BFu x=E1=BB=AD".</li>
 <li class=3D"code-line" data-uuid=3D"4b578e90-0527-484f-a021-8cfe3b13b2da"=
><strong>When (Khi):</strong><span>&nbsp;</span>Nh=C3=A2n vi=C3=AAn ch=E1=
=BB=8Dn nguy=C3=AAn li=E1=BB=87u, g=C3=A1n nh=C3=A3n c=C3=B4ng =C4=91o=E1=
=BA=A1n v=C3=A0 nh=E1=BA=A5n n=C3=BAt<span>&nbsp;</span><strong>[ L=C6=B0u =
]</strong>.</li>
 <li class=3D"code-line" data-uuid=3D"aadbbd1c-3df2-4670-9753-12b633cc18ac"=
><strong>Then (Th=C3=AC):</strong><span>&nbsp;</span>H=E1=BB=87 th=E1=BB=91=
ng t=E1=BA=A1o phi=E1=BA=BFu th=C3=A0nh c=C3=B4ng. Phi=E1=BA=BFu =E1=BB=9F =
tr=E1=BA=A1ng th=C3=A1i<span>&nbsp;</span><code>=C4=90=C3=A3 so=E1=BA=A1n</=
code>. T=C3=ACnh tr=E1=BA=A1ng nguy=C3=AAn li=E1=BB=87u =C4=91=C3=A1nh d=E1=
=BA=A5u l=C3=A0<span>&nbsp;</span><code>=C4=90ang x=E1=BB=AD l=C3=BD</code>=
<span>&nbsp;</span>(kh=C3=B3a kh=E1=BB=8Fi kho).</li>
 <li class=3D"code-line" data-uuid=3D"60413557-77f6-4ba7-a4f0-7aaeddcb7165"=
><strong>And (V=C3=A0):</strong><span>&nbsp;</span>N=E1=BA=BFu checkbox<spa=
n>&nbsp;</span><strong>"In phi=E1=BA=BFu"</strong><span>&nbsp;</span>=C4=91=
=C6=B0=E1=BB=A3c t=C3=ADch ch=E1=BB=8Dn, h=E1=BB=87 th=E1=BB=91ng t=E1=BB=
=B1 =C4=91=E1=BB=99ng xu=E1=BA=A5t b=E1=BA=A3n in (PDF) ngay sau khi l=C6=
=B0u.</li>
</ul>
<h3 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E4.US02:[X=E1=BB=ADl=C3=BDNL]=
T=E1=BA=A1om=E1=BB=9BiShootingOrder-AC2:T=E1=BA=A1om=E1=BB=9Biv=C3=A0B=C3=
=A0ngiao(N=C3=BAtL=C6=B0uv=C3=A0Chuy=E1=BB=83n)">AC 2: T=E1=BA=A1o m=E1=BB=
=9Bi v=C3=A0 B=C3=A0n giao (N=C3=BAt L=C6=B0u v=C3=A0 Chuy=E1=BB=83n)</h3>
<ul class=3D"code-line">
 <li class=3D"code-line" data-uuid=3D"1b9dbe1e-b57d-4111-9a7c-78e754f06a1d"=
><strong>Given (Bi=E1=BA=BFt r=E1=BA=B1ng):</strong><span>&nbsp;</span>Nh=
=C3=A2n vi=C3=AAn =C4=91ang =E1=BB=9F m=C3=A0n h=C3=ACnh t=E1=BA=A1o m=E1=
=BB=9Bi "Phi=E1=BA=BFu x=E1=BB=AD".</li>
 <li class=3D"code-line" data-uuid=3D"b7139965-c6ed-41f0-b0b8-c242011c0bf9"=
><strong>When (Khi):</strong><span>&nbsp;</span>Nh=C3=A2n vi=C3=AAn nh=E1=
=BA=A5n n=C3=BAt<span>&nbsp;</span><strong>[ L=C6=B0u v=C3=A0 Chuy=E1=BB=83=
n ]</strong>.</li>
 <li class=3D"code-line" data-uuid=3D"40f4d475-ace5-4472-8446-1b86a2c4d10b"=
><strong>Then (Th=C3=AC):</strong><span>&nbsp;</span>H=E1=BB=87 th=E1=BB=91=
ng hi=E1=BB=83n th=E1=BB=8B Popup/Modal ch=E1=BB=8Dn<span>&nbsp;</span><str=
ong>Ng=C6=B0=E1=BB=9Di nh=E1=BA=ADn</strong><span>&nbsp;</span>(Assignee).<=
/li>
 <li class=3D"code-line" data-uuid=3D"ec17fbc4-6627-46a2-880c-8deb960ab785"=
><strong>And (V=C3=A0):</strong><span>&nbsp;</span>Sau khi ch=E1=BB=8Dn ng=
=C6=B0=E1=BB=9Di nh=E1=BA=ADn v=C3=A0 x=C3=A1c nh=E1=BA=ADn, h=E1=BB=87 th=
=E1=BB=91ng t=E1=BA=A1o phi=E1=BA=BFu th=C3=A0nh c=C3=B4ng.</li>
 <li class=3D"code-line" data-uuid=3D"c68b369c-5f8d-46aa-a138-54e7308731ad"=
><strong>Then (Th=C3=AC):</strong><span>&nbsp;</span>Tr=E1=BA=A1ng th=C3=A1=
i phi=E1=BA=BFu t=E1=BB=B1 =C4=91=E1=BB=99ng chuy=E1=BB=83n sang<span>&nbsp=
;</span><code>=C4=90ang x=E1=BB=AD l=C3=BD</code>. Ghi nh=E1=BA=ADn th=C3=
=B4ng tin Ng=C6=B0=E1=BB=9Di nh=E1=BA=ADn v=C3=A0o phi=E1=BA=BFu.</li>
 <li class=3D"code-line" data-uuid=3D"fe15abf9-86ef-4571-827e-97171879ed68"=
><strong>And (V=C3=A0):</strong><span>&nbsp;</span>N=E1=BA=BFu checkbox<spa=
n>&nbsp;</span><strong>"In phi=E1=BA=BFu"</strong><span>&nbsp;</span>=C4=91=
=C6=B0=E1=BB=A3c t=C3=ADch ch=E1=BB=8Dn, h=E1=BB=87 th=E1=BB=91ng t=E1=BB=
=B1 =C4=91=E1=BB=99ng xu=E1=BA=A5t b=E1=BA=A3n in (PDF) ngay sau khi b=C3=
=A0n giao th=C3=A0nh c=C3=B4ng.</li>
</ul>
<h3 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E4.US02:[X=E1=BB=ADl=C3=BDNL]=
T=E1=BA=A1om=E1=BB=9BiShootingOrder-AC3:G=C3=A1nnh=C3=A3nc=C3=B4ng=C4=91o=
=E1=BA=A1n(Labels)">AC 3: G=C3=A1n nh=C3=A3n c=C3=B4ng =C4=91o=E1=BA=A1n (L=
abels)</h3>
<ul class=3D"code-line">
 <li class=3D"code-line" data-uuid=3D"cc4c1414-8560-491b-8219-4b9b06f2dcef"=
><strong>Given (Bi=E1=BA=BFt r=E1=BA=B1ng):</strong><span>&nbsp;</span>Nh=
=C3=A2n vi=C3=AAn =C4=91ang nh=E1=BA=ADp th=C3=B4ng tin Phi=E1=BA=BFu x=E1=
=BB=AD.</li>
 <li class=3D"code-line" data-uuid=3D"7256ebd0-45e1-4623-86e4-555cc168ed82"=
><strong>When (Khi):</strong><span>&nbsp;</span>Click v=C3=A0o tr=C6=B0=E1=
=BB=9Dng "C=C3=B4ng =C4=91o=E1=BA=A1n y=C3=AAu c=E1=BA=A7u".</li>
 <li class=3D"code-line" data-uuid=3D"ecfee973-aae3-4802-944f-443569a0202e"=
><strong>Then (Th=C3=AC):</strong><span>&nbsp;</span>X=E1=BB=95 ra danh s=
=C3=A1ch c=C3=A1c c=C3=B4ng =C4=91o=E1=BA=A1n thu=E1=BB=99c nh=C3=B3m "X=E1=
=BB=AD" =C4=91=E1=BB=83 ch=E1=BB=8Dn.</li>
</ul>
<h3 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E4.US02:[X=E1=BB=ADl=C3=BDNL]=
T=E1=BA=A1om=E1=BB=9BiShootingOrder-AC4:Th=C3=AAm/X=C3=B3anguy=C3=AAnli=E1=
=BB=87u(PickMaterials)">AC 4: Th=C3=AAm/X=C3=B3a nguy=C3=AAn li=E1=BB=87u (=
Pick Materials)</h3>
<ul class=3D"code-line">
 <li class=3D"code-line" data-uuid=3D"ef177c3c-af72-43cf-96a3-d15a174781ce"=
><strong>Given (Bi=E1=BA=BFt r=E1=BA=B1ng):</strong><span>&nbsp;</span>Nh=
=C3=A2n vi=C3=AAn =C4=91ang =E1=BB=9F m=C3=A0n h=C3=ACnh t=E1=BA=A1o phi=E1=
=BA=BFu.</li>
 <li class=3D"code-line" data-uuid=3D"1d471db6-a9f8-4462-bf5a-1c132ee980ff"=
><strong>When (Khi):</strong><span>&nbsp;</span>Ch=E1=BB=8Dn nguy=C3=AAn li=
=E1=BB=87u t=E1=BB=AB danh s=C3=A1ch t=E1=BB=93n kho (Panel tr=C3=A1i) =C4=
=91=E1=BA=A9y sang Phi=E1=BA=BFu (Panel ph=E1=BA=A3i), ho=E1=BA=B7c qu=C3=
=A9t "M=C3=A3 L=C3=B4".</li>
 <li class=3D"code-line" data-uuid=3D"ed0e89f5-4b6f-426f-9e24-aaa2832d8207"=
><strong>Then (Th=C3=AC):</strong>
  <ul class=3D"code-line">
   <li class=3D"code-line"><strong>Panel Tr=C3=A1i (Pick List):</strong><sp=
an>&nbsp;</span>Chia th=C3=A0nh 2 tab:=20
    <ul class=3D"code-line">
     <li class=3D"code-line"><strong>Tab 1 - Kho NL:</strong><span>&nbsp;</=
span>Danh s=C3=A1ch nguy=C3=AAn li=E1=BB=87u t=E1=BB=93n kho. H=E1=BB=97 tr=
=E1=BB=A3 l=E1=BB=8Dc theo T=C3=ACnh tr=E1=BA=A1ng.</li>
     <li class=3D"code-line"><strong>Tab 2 - Kho h=E1=BB=99i:</strong><span=
>&nbsp;</span>Danh s=C3=A1ch nguy=C3=AAn li=E1=BB=87u h=E1=BB=99i. M=E1=BA=
=B7c =C4=91=E1=BB=8Bnh filter t=C3=ACnh tr=E1=BA=A1ng =3D "H=E1=BB=99i h=C3=
=A0ng ng=C3=A0y".</li>
    </ul></li>
   <li class=3D"code-line"><strong>Panel Ph=E1=BA=A3i (Line Items):</strong=
><span>&nbsp;</span>Danh s=C3=A1ch nguy=C3=AAn li=E1=BB=87u =C4=91=C3=A3 ch=
=E1=BB=8Dn v=C3=A0o phi=E1=BA=BFu.</li>
   <li class=3D"code-line"><strong>Validate (Quy t=E1=BA=AFc):</strong>
    <ul class=3D"code-line">
     <li class=3D"code-line">T=E1=BA=A5t c=E1=BA=A3 nguy=C3=AAn li=E1=BB=87=
u ch=C3=ADnh ph=E1=BA=A3i c=C3=B9ng chung 1 t=C3=ACnh tr=E1=BA=A1ng (Status=
).</li>
     <li class=3D"code-line"><strong>Ngo=E1=BA=A1i l=E1=BB=87:</strong><spa=
n>&nbsp;</span>H=E1=BB=87 th=E1=BB=91ng cho ph=C3=A9p ch=E1=BB=8Dn th=C3=AA=
m nguy=C3=AAn li=E1=BB=87u ph=E1=BB=A5 tr=E1=BB=A3 t=E1=BB=AB<span>&nbsp;</=
span><strong>Kho h=E1=BB=99i</strong><span>&nbsp;</span>v=E1=BB=9Bi t=C3=AC=
nh tr=E1=BA=A1ng<span>&nbsp;</span><strong>"H=E1=BB=99i h=C3=A0ng ng=C3=A0y=
"</strong><span>&nbsp;</span>=C4=91=E1=BB=83 pha tr=E1=BB=99n/x=E1=BB=AD l=
=C3=BD, kh=C3=B4ng b=E1=BB=8B gi=E1=BB=9Bi h=E1=BA=A1n b=E1=BB=9Fi quy t=E1=
=BA=AFc c=C3=B9ng t=C3=ACnh tr=E1=BA=A1ng c=E1=BB=A7a nguy=C3=AAn li=E1=BB=
=87u ch=C3=ADnh.</li>
    </ul></li>
  </ul></li>
</ul>
<h3 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E4.US02:[X=E1=BB=ADl=C3=BDNL]=
T=E1=BA=A1om=E1=BB=9BiShootingOrder-AC5:Ch=E1=BB=89nhs=E1=BB=ADakh=E1=BB=91=
il=C6=B0=E1=BB=A3ngc=E1=BA=A7nd=C3=B9ng(TLt=E1=BB=95ng)&amp;T=C3=ADnht=E1=
=BB=95ngphi=E1=BA=BFu">AC 5: Ch=E1=BB=89nh s=E1=BB=ADa kh=E1=BB=91i l=C6=B0=
=E1=BB=A3ng c=E1=BA=A7n d=C3=B9ng (TL t=E1=BB=95ng) &amp; T=C3=ADnh t=E1=BB=
=95ng phi=E1=BA=BFu</h3>
<ul class=3D"code-line">
 <li class=3D"code-line" data-uuid=3D"d26016cd-3737-430b-89ca-d50a8e838525"=
><strong>Given (Bi=E1=BA=BFt r=E1=BA=B1ng):</strong><span>&nbsp;</span>Nh=
=C3=A2n vi=C3=AAn =C4=91ang =E1=BB=9F Line Items.</li>
 <li class=3D"code-line" data-uuid=3D"fe7adc11-4222-40c1-b273-3a0a594a7d17"=
><strong>When (Khi):</strong><span>&nbsp;</span>Thay =C4=91=E1=BB=95i "TL t=
=E1=BB=95ng" (nh=E1=BA=ADp tay ho=E1=BA=B7c d=C3=B9ng c=C3=A2n =C4=91i=E1=
=BB=87n t=E1=BB=AD focus) cho t=E1=BB=ABng d=C3=B2ng nguy=C3=AAn li=E1=BB=
=87u.</li>
 <li class=3D"code-line" data-uuid=3D"eac9b990-eb18-4da2-8bf4-9245821c56de"=
><strong>Then (Th=C3=AC):</strong><span>&nbsp;</span>H=E1=BB=87 th=E1=BB=91=
ng t=E1=BB=B1 =C4=91=E1=BB=99ng t=C3=ADnh l=E1=BA=A1i TL kim lo=E1=BA=A1i v=
=C3=A0 Quy 99.99 t=C6=B0=C6=A1ng =E1=BB=A9ng cho d=C3=B2ng =C4=91=C3=B3.</l=
i>
 <li class=3D"code-line" data-uuid=3D"9f7ea9e3-35a9-48a9-9e7f-e51e8ea6bfba"=
><strong>And (V=C3=A0):</strong><span>&nbsp;</span>H=E1=BB=87 th=E1=BB=91ng=
 t=E1=BB=B1 =C4=91=E1=BB=99ng c=E1=BA=ADp nh=E1=BA=ADt<span>&nbsp;</span><s=
trong>T=E1=BB=95ng kh=E1=BB=91i l=C6=B0=E1=BB=A3ng</strong><span>&nbsp;</sp=
an>c=E1=BB=A7a to=C3=A0n phi=E1=BA=BFu (Sum of TL t=E1=BB=95ng, Sum of TL k=
im lo=E1=BA=A1i, Sum of Quy 99.99) hi=E1=BB=83n th=E1=BB=8B t=E1=BA=A1i ph=
=E1=BA=A7n Footer c=E1=BB=A7a danh s=C3=A1ch.</li>
</ul>
<hr class=3D"code-line">
<h2 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E4.US02:[X=E1=BB=ADl=C3=BDNL]=
T=E1=BA=A1om=E1=BB=9BiShootingOrder-3.THI=E1=BA=BETK=E1=BA=BE(UX/UI)*">3. T=
HI=E1=BA=BET K=E1=BA=BE (UX/UI) *</h2>
<ul class=3D"code-line">
 <li class=3D"code-line" data-uuid=3D"fdba9d5c-743e-41f6-b633-ab7e1ef1237d"=
><strong>M=C3=B4 t=E1=BA=A3 Layout:</strong>
  <ul class=3D"code-line">
   <li class=3D"code-line"><strong>M=C3=A0n h=C3=ACnh Create:</strong>
    <ul class=3D"code-line">
     <li class=3D"code-line">Header: Ch=E1=BB=A9a th=C3=B4ng tin "C=C3=B4ng=
 =C4=91o=E1=BA=A1n y=C3=AAu c=E1=BA=A7u".</li>
     <li class=3D"code-line">Action Buttons:<span>&nbsp;</span><code>[ L=C6=
=B0u ]</code>,<span>&nbsp;</span><code>[ L=C6=B0u v=C3=A0 Chuy=E1=BB=83n ]<=
/code><span>&nbsp;</span>v=C3=A0 Checkbox<span>&nbsp;</span><strong>[ ] In =
phi=E1=BA=BFu</strong>.</li>
     <li class=3D"code-line">Th=C3=A2n (Line items) d=E1=BA=A1ng<span>&nbsp=
;</span><strong>Split Layout (2 panel)</strong>: Tr=C3=A1i l=C3=A0 T=E1=BB=
=93n kho, Ph=E1=BA=A3i l=C3=A0 Danh s=C3=A1ch nguy=C3=AAn li=E1=BB=87u tron=
g phi=E1=BA=BFu.</li>
     <li class=3D"code-line"><strong>Smart Input:</strong><span>&nbsp;</spa=
n>Qu=C3=A9t M=C3=A3 L=C3=B4 -&gt; t=E1=BB=B1 pick NL qua. Focus =C3=B4 TL t=
=E1=BB=95ng + thao t=C3=A1c c=C3=A2n -&gt; =C4=91i=E1=BB=81n s=E1=BB=91.</l=
i>
     <li class=3D"code-line"><strong>Popup ch=E1=BB=8Dn Ng=C6=B0=E1=BB=9Di =
nh=E1=BA=ADn:</strong><span>&nbsp;</span>Xu=E1=BA=A5t hi=E1=BB=87n khi b=E1=
=BA=A5m "L=C6=B0u v=C3=A0 Chuy=E1=BB=83n". Danh s=C3=A1ch nh=C3=A2n vi=C3=
=AAn =C4=91=C6=B0=E1=BB=A3c filter theo b=E1=BB=99 ph=E1=BA=ADn X=E1=BB=AD =
l=C3=BD/MC v=C3=A0 s=E1=BA=AFp x=E1=BA=BFp theo =C6=B0u ti=C3=AAn (BR-04).<=
/li>
    </ul></li>
  </ul></li>
</ul>
