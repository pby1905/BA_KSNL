    <div class=3D"Section1">
        <h2 id=3D"id-=E2=9C=85CS1.E1.US01:[Nh=E1=BA=ADnNLkh=C3=A1ch]T=E1=BA=
=A1o,l=C6=B0u,l=C6=B0unh=C3=A1p,innh=C3=A3n-1.USERSTORY*"><strong>1. USER S=
TORY *</strong></h2>
<p><strong>L=C3=A0 m=E1=BB=99t (As a):</strong> Nh=C3=A2n vi=C3=AAn ti=E1=
=BA=BFp nh=E1=BA=ADn nguy=C3=AAn li=E1=BB=87u</p>
<p><strong>T=C3=B4i mu=E1=BB=91n (I want):</strong> T=E1=BA=A1o phi=E1=BA=
=BFu ti=E1=BA=BFp nh=E1=BA=ADn nguy=C3=AAn li=E1=BB=87u t=E1=BB=AB kh=C3=A1=
ch h=C3=A0ng, ghi nh=E1=BA=ADn th=C3=B4ng tin bao b=C3=AC v=C3=A0 tr=E1=BB=
=8Dng l=C6=B0=E1=BB=A3ng ban =C4=91=E1=BA=A7u.</p>
<p><strong>=C4=90=E1=BB=83 (So that):</strong> T=C3=B4i c=C3=B3 th=E1=BB=83=
 thi=E1=BA=BFt l=E1=BA=ADp c=C6=A1 s=E1=BB=9F d=E1=BB=AF li=E1=BB=87u ban =
=C4=91=E1=BA=A7u cho vi=E1=BB=87c gia c=C3=B4ng, =C4=91=E1=BA=A3m b=E1=BA=
=A3o t=C3=ADnh minh b=E1=BA=A1ch v=E1=BB=81 tr=E1=BB=8Dng l=C6=B0=E1=BB=A3n=
g nguy=C3=AAn li=E1=BB=87u gi=E1=BB=AFa kh=C3=A1ch h=C3=A0ng v=C3=A0 x=C6=
=B0=E1=BB=9Fng.</p>
<hr>
<h2 id=3D"id-=E2=9C=85CS1.E1.US01:[Nh=E1=BA=ADnNLkh=C3=A1ch]T=E1=BA=A1o,l=
=C6=B0u,l=C6=B0unh=C3=A1p,innh=C3=A3n-2.TI=C3=8AUCH=C3=8DCH=E1=BA=A4PNH=E1=
=BA=ACN(ACCEPTANCECRITERIA-AC)*"><strong>2. TI=C3=8AU CH=C3=8D CH=E1=BA=A4P=
 NH=E1=BA=ACN (ACCEPTANCE CRITERIA - AC) *</strong></h2>
<h3 id=3D"id-=E2=9C=85CS1.E1.US01:[Nh=E1=BA=ADnNLkh=C3=A1ch]T=E1=BA=A1o,l=
