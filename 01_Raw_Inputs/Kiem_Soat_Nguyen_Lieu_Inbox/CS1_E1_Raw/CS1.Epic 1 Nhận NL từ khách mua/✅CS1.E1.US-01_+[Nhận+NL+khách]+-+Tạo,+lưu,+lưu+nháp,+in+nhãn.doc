o m=E1=BB=9Bi phi=E1=BA=BFu ti=E1=BA=BFp nh=E1=BA=ADn th=C3=A0nh c=C3=B4ng =
(L=C6=B0u)</h3>
<ul>
 <li data-uuid=3D"7a7908e2-ca6e-4734-8f59-37a116e23c2d">
  <p><strong>Given (Bi=E1=BA=BFt r=E1=BA=B1ng):</strong> Nh=C3=A2n vi=C3=AA=
n ti=E1=BA=BFp nh=E1=BA=ADn =C4=91ang =E1=BB=9F m=C3=A0n h=C3=ACnh "T=E1=BA=
=A1o phi=E1=BA=BFu ti=E1=BA=BFp nh=E1=BA=ADn NL".</p></li>
 <li data-uuid=3D"ec3b1a83-dd25-4409-ad3e-17e6b2703eb3">
  <p><strong>When (Khi):</strong> Nh=C3=A2n vi=C3=AAn nh=E1=BA=ADp =C4=91=
=E1=BA=A7y =C4=91=E1=BB=A7 c=C3=A1c tr=C6=B0=E1=BB=9Dng b=E1=BA=AFt bu=E1=
=BB=99c (Kh=C3=A1ch h=C3=A0ng, Ng=C3=A0y nh=E1=BA=ADn, T=C3=ACnh tr=E1=BA=
=A1ng bao b=C3=AC, Tr=E1=BB=8Dng l=C6=B0=E1=BB=A3ng th=E1=BB=B1c t=E1=BA=BF=
) v=C3=A0 nh=E1=BA=A5n <strong>"L=C6=B0u"</strong>.</p></li>
 <li data-uuid=3D"63a54bd7-426e-496d-96eb-882e799376bb">
  <p><strong>Then (Th=C3=AC):</strong> H=E1=BB=87 th=E1=BB=91ng hi=E1=BB=83=
n th=E1=BB=8B th=C3=B4ng b=C3=A1o "T=E1=BA=A1o phi=E1=BA=BFu ti=E1=BA=BFp n=
h=E1=BA=ADn th=C3=A0nh c=C3=B4ng", d=E1=BB=AF li=E1=BB=87u =C4=91=C6=B0=E1=
=BB=A3c l=C6=B0u v=C3=A0o tr=E1=BA=A1ng th=C3=A1i "=C4=90ang th=E1=BB=B1c h=
i=E1=BB=87n" v=C3=A0 h=E1=BB=87 th=E1=BB=91ng chuy=E1=BB=83n h=C6=B0=E1=BB=
=9Bng =C4=91=E1=BA=BFn b=C6=B0=E1=BB=9Bc Ki=E1=BB=83m tra tr=E1=BB=8Dng l=
=C6=B0=E1=BB=A3ng chi ti=E1=BA=BFt.</p></li>
</ul>
<h3 id=3D"id-=E2=9C=85CS1.E1.US01:[Nh=E1=BA=ADnNLkh=C3=A1ch]T=E1=BA=A1o,l=
=C6=B0u,l=C6=B0unh=C3=A1p,innh=C3=A3n-AC2:T=C3=ADnhto=C3=A1nch=C3=AAnhl=E1=
=BB=87chtr=E1=BB=8Dngl=C6=B0=E1=BB=A3ngt=E1=BB=B1=C4=91=E1=BB=99ng">AC 2: T=
=C3=ADnh to=C3=A1n ch=C3=AAnh l=E1=BB=87ch tr=E1=BB=8Dng l=C6=B0=E1=BB=A3ng=
 t=E1=BB=B1 =C4=91=E1=BB=99ng</h3>
<ul>
 <li data-uuid=3D"6e5c5037-f783-459c-851e-074874d69dde">
  <p><strong>Given (Bi=E1=BA=BFt r=E1=BA=B1ng):</strong> Nh=C3=A2n vi=C3=AA=
n =C4=91ang nh=E1=BA=ADp th=C3=B4ng tin t=E1=BA=A1i ph=E1=BA=A7n "X=C3=A1c =
nh=E1=BA=ADn bao b=C3=AC".</p></li>
 <li data-uuid=3D"eb827b4b-0d8c-48da-a0e5-bc3fd6337a20">
  <p><strong>When (Khi):</strong> Nh=C3=A2n vi=C3=AAn nh=E1=BA=ADp "Tr=E1=
=BB=8Dng l=C6=B0=E1=BB=A3ng g=E1=BB=93m bao b=C3=AC kh=C3=A1ch b=C3=A1o" v=
=C3=A0 "Tr=E1=BB=8Dng l=C6=B0=E1=BB=A3ng th=E1=BB=B1c t=E1=BA=BF".</p></li>
 <li data-uuid=3D"7777667e-4712-46e6-a017-ededa21daa94">
  <p><strong>Then (Th=C3=AC):</strong> H=E1=BB=87 th=E1=BB=91ng t=E1=BB=B1 =
=C4=91=E1=BB=99ng t=C3=ADnh to=C3=A1n tr=C6=B0=E1=BB=9Dng "Ch=C3=AAnh l=E1=
=BB=87ch" =3D [Tr=E1=BB=8Dng l=C6=B0=E1=BB=A3ng g=E1=BB=93m bao b=C3=AC kh=
=C3=A1ch b=C3=A1o] - [Tr=E1=BB=8Dng l=C6=B0=E1=BB=A3ng th=E1=BB=B1c t=E1=BA=
=BF]</p></li>
</ul>
<h3 id=3D"id-=E2=9C=85CS1.E1.US01:[Nh=E1=BA=ADnNLkh=C3=A1ch]T=E1=BA=A1o,l=
=C6=B0u,l=C6=B0unh=C3=A1p,innh=C3=A3n-AC3:L=C6=B0unh=C3=A1pphi=E1=BA=BFuti=
=E1=BA=BFpnh=E1=BA=ADn">AC 3: L=C6=B0u nh=C3=A1p phi=E1=BA=BFu ti=E1=BA=BFp=
 nh=E1=BA=ADn</h3>
<ul>
 <li data-uuid=3D"e938a1ea-94c3-47c4-a457-ed7bcca9976c">
  <p><strong>Given (Bi=E1=BA=BFt r=E1=BA=B1ng):</strong> Nh=C3=A2n vi=C3=AA=
n =C4=91=C3=A3 nh=E1=BA=ADp m=E1=BB=99t ph=E1=BA=A7n th=C3=B4ng tin nh=C6=
=B0ng ch=C6=B0a xong.</p></li>
 <li data-uuid=3D"0caaac5d-ef32-41e3-9067-876dd043f422">
  <p><strong>When (Khi):</strong> Nh=C3=A2n vi=C3=AAn nh=E1=BA=A5n <strong>=
"L=C6=B0u nh=C3=A1p"</strong>.</p></li>
 <li data-uuid=3D"db3078a6-0ff0-441b-83c2-a38b77336c44">
  <p><strong>Then (Th=C3=AC):</strong> H=E1=BB=87 th=E1=BB=91ng l=C6=B0u l=
=E1=BA=A1i c=C3=A1c th=C3=B4ng tin =C4=91=C3=A3 nh=E1=BA=ADp, tr=E1=BA=A1ng=
 th=C3=A1i phi=E1=BA=BFu l=C3=A0 "Nh=C3=A1p", d=E1=BB=AF li=E1=BB=87u kh=C3=
=B4ng b=E1=BB=8B ki=E1=BB=83m tra c=C3=A1c r=C3=A0ng bu=E1=BB=99c b=E1=BA=
=AFt bu=E1=BB=99c (ngo=E1=BA=A1i tr=E1=BB=AB tr=C6=B0=E1=BB=9Dng Kh=C3=A1ch=
 h=C3=A0ng).</p></li>
</ul>
<h3 id=3D"id-=E2=9C=85CS1.E1.US01:[Nh=E1=BA=ADnNLkh=C3=A1ch]T=E1=BA=A1o,l=
=C6=B0u,l=C6=B0unh=C3=A1p,innh=C3=A3n-AC4:L=C6=B0u&amp;Innh=C3=A3nth=C3=A0n=
hc=C3=B4ng">AC 4: L=C6=B0u &amp; In nh=C3=A3n th=C3=A0nh c=C3=B4ng</h3>
<ul>
 <li data-uuid=3D"22b783a0-185f-4d69-9b04-9a110e02ea1c">
  <p><strong>Given (Bi=E1=BA=BFt r=E1=BA=B1ng):</strong> Nh=C3=A2n vi=C3=AA=
n =C4=91=C3=A3 nh=E1=BA=ADp =C4=91=E1=BA=A7y =C4=91=E1=BB=A7 th=C3=B4ng tin=
 b=E1=BA=AFt bu=E1=BB=99c.</p></li>
 <li data-uuid=3D"6599f1fc-38e4-42e6-a934-8c239a8ae1ac">
  <p><strong>When (Khi):</strong> Nh=C3=A2n vi=C3=AAn nh=E1=BA=A5n <strong>=
"L=C6=B0u &amp; In nh=C3=A3n"</strong>.</p></li>
 <li data-uuid=3D"c72278af-fd7d-434d-92b2-879b810e76b9">
  <p><strong>Then (Th=C3=AC):</strong> H=E1=BB=87 th=E1=BB=91ng th=E1=BB=B1=
c hi=E1=BB=87n L=C6=B0u phi=E1=BA=BFu =C4=91=E1=BB=93ng th=E1=BB=9Di hi=E1=
=BB=83n th=E1=BB=8B pop-up/m=C3=A0n h=C3=ACnh xem tr=C6=B0=E1=BB=9Bc b=E1=
=BA=A3n in (Label) bao g=E1=BB=93m: M=C3=A3 phi=E1=BA=BFu, T=C3=AAn kh=C3=
=A1ch h=C3=A0ng, Tr=E1=BB=8Dng l=C6=B0=E1=BB=A3ng th=E1=BB=B1c t=E1=BA=BF, =
Ng=C3=A0y nh=E1=BA=ADn.</p></li>
</ul>
<h3 id=3D"id-=E2=9C=85CS1.E1.US01:[Nh=E1=BA=ADnNLkh=C3=A1ch]T=E1=BA=A1o,l=
