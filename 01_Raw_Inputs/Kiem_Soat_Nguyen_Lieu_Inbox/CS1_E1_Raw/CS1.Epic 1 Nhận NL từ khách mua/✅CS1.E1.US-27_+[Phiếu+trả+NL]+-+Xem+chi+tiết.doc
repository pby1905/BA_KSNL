    <h1>=E2=9C=85CS1.E1.US-27: [Phi=E1=BA=BFu tr=E1=BA=A3 NL] - Xem chi ti=
=E1=BA=BFt</h1>
    <div class=3D"Section1">
        <h3 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E1.US27:[Phi=E1=BA=BF=
utr=E1=BA=A3NL]Xemchiti=E1=BA=BFt-1.USERSTORY">1. USER STORY</h3>
<ul>
 <li class=3D"code-line" data-uuid=3D"5cabec8f-2c6d-419a-a1ef-15d47f4ef01c"=
><strong>L=C3=A0 m=E1=BB=99t (As a):</strong><span>&nbsp;</span>Qu=E1=BA=A3=
n l=C3=BD / Nh=C3=A2n vi=C3=AAn MC / K=E1=BA=BF to=C3=A1n kho c=C3=B3 th=E1=
=BA=A9m quy=E1=BB=81n.<span>&nbsp;</span></li>
 <li class=3D"code-line" data-uuid=3D"b48cafca-fa51-410f-bcc2-48c49a8de1cd"=
><strong>T=C3=B4i mu=E1=BB=91n (I want):</strong><span>&nbsp;</span>Xem chi=
 ti=E1=BA=BFt n=E1=BB=99i dung c=E1=BB=A7a m=E1=BB=99t "Phi=E1=BA=BFu tr=E1=
=BA=A3 NL" (Material Return Ticket).<span>&nbsp;</span></li>
 <li class=3D"code-line" data-uuid=3D"47bdb457-ed66-45d0-a115-77d785cb53a0"=
><strong>=C4=90=E1=BB=83 (So that):</strong><span>&nbsp;</span>T=C3=B4i n=
=E1=BA=AFm b=E1=BA=AFt ch=C3=ADnh x=C3=A1c th=C3=B4ng tin kh=C3=A1ch h=C3=
=A0ng, danh s=C3=A1ch c=C3=A1c nguy=C3=AAn li=E1=BB=87u b=E1=BB=8B tr=E1=BA=
=A3 l=E1=BA=A1i, l=C3=BD do l=E1=BB=97i v=C3=A0 tr=E1=BA=A1ng th=C3=A1i hi=
=E1=BB=87n t=E1=BA=A1i c=E1=BB=A7a phi=E1=BA=BFu, t=E1=BB=AB =C4=91=C3=B3 t=
h=E1=BB=B1c hi=E1=BB=87n c=C3=A1c b=C6=B0=E1=BB=9Bc ti=E1=BA=BFp theo (nh=
=C6=B0 li=C3=AAn h=E1=BB=87 kh=C3=A1ch, in bi=C3=AAn b=E1=BA=A3n b=C3=A0n g=
iao, ho=E1=BA=B7c l=C6=B0u tr=E1=BB=AF ch=E1=BB=A9ng t=E1=BB=AB).</li>
</ul>
<h3 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E1.US27:[Phi=E1=BA=BFutr=E1=
=BA=A3NL]Xemchiti=E1=BA=BFt-2.TI=C3=8AUCH=C3=8DCH=E1=BA=A4PNH=E1=BA=ACN(ACC=
EPTANCECRITERIA-AC)">2. TI=C3=8AU CH=C3=8D CH=E1=BA=A4P NH=E1=BA=ACN (ACCEP=
TANCE CRITERIA - AC)</h3>
<h3 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E1.US27:[Phi=E1=BA=BFutr=E1=
=BA=A3NL]Xemchiti=E1=BA=BFt-AC1:Truyc=E1=BA=ADpv=C3=A0Hi=E1=BB=83nth=E1=BB=
=8Bth=C3=B4ngtinchung(Header)">AC 1: Truy c=E1=BA=ADp v=C3=A0 Hi=E1=BB=83n =
th=E1=BB=8B th=C3=B4ng tin chung (Header)</h3>
<p class=3D"code-line"><strong>Given (Bi=E1=BA=BFt r=E1=BA=B1ng):</strong><=
span>&nbsp;</span>Ng=C6=B0=E1=BB=9Di d=C3=B9ng =C4=91ang =E1=BB=9F m=C3=A0n=
 h=C3=ACnh Danh s=C3=A1ch Phi=E1=BA=BFu tr=E1=BA=A3 NL.<span>&nbsp;</span><=
/p>
<p class=3D"code-line"><strong>When (Khi):</strong><span>&nbsp;</span>Ng=C6=
=B0=E1=BB=9Di d=C3=B9ng click v=C3=A0o M=C3=A3 phi=E1=BA=BFu ho=E1=BA=B7c n=
=C3=BAt "Xem chi ti=E1=BA=BFt" c=E1=BB=A7a m=E1=BB=99t d=C3=B2ng d=E1=BB=AF=
 li=E1=BB=87u.<span>&nbsp;</span></p>
<p class=3D"code-line"><strong>Then (Th=C3=AC):</strong><span>&nbsp;</span>=
H=E1=BB=87 th=E1=BB=91ng chuy=E1=BB=83n h=C6=B0=E1=BB=9Bng sang m=C3=A0n h=
=C3=ACnh Chi ti=E1=BA=BFt Phi=E1=BA=BFu tr=E1=BA=A3 NL v=C3=A0 hi=E1=BB=83n=
 th=E1=BB=8B c=C3=A1c th=C3=B4ng tin chung:</p>
<ul class=3D"code-line">
 <li class=3D"code-line" data-uuid=3D"f903f711-f926-43c9-bf44-5d16ed3ce487"=
>M=C3=A3 phi=E1=BA=BFu tr=E1=BA=A3 (Return Ticket ID).</li>
 <li class=3D"code-line" data-uuid=3D"637372dc-6c3d-4746-8d51-71784788fbd5"=
>Tr=E1=BA=A1ng th=C3=A1i phi=E1=BA=BFu (V=C3=AD d=E1=BB=A5: M=E1=BB=9Bi t=
=E1=BA=A1o, Ch=E1=BB=9D kh=C3=A1ch nh=E1=BA=ADn, Ho=C3=A0n th=C3=A0nh, =C4=
=90=C3=A3 h=E1=BB=A7y).</li>
 <li class=3D"code-line" data-uuid=3D"4cf4f107-60ee-4f54-ae60-35dee2dca89c"=
>Th=C3=B4ng tin kh=C3=A1ch h=C3=A0ng / Nh=C3=A0 cung c=E1=BA=A5p (T=C3=AAn,=
 S=E1=BB=91 =C4=91i=E1=BB=87n tho=E1=BA=A1i, M=C3=A3 KH).</li>
 <li class=3D"code-line" data-uuid=3D"3024eb3e-6dfe-4926-93d6-b080853d9fa9"=
>Th=C3=B4ng tin tham chi=E1=BA=BFu: M=C3=A3 Phi=E1=BA=BFu ti=E1=BA=BFp nh=
=E1=BA=ADn g=E1=BB=91c (Clickable - c=C3=B3 th=E1=BB=83 click =C4=91=E1=BB=
=83 xem phi=E1=BA=BFu g=E1=BB=91c).</li>
 <li class=3D"code-line" data-uuid=3D"97b0e7f9-681f-4930-baf8-665536210420"=
>Ng=C3=A0y t=E1=BA=A1o phi=E1=BA=BFu &amp; Ng=C6=B0=E1=BB=9Di t=E1=BA=A1o (=
Nh=C3=A2n vi=C3=AAn MC).</li>
</ul>
<h3 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E1.US27:[Phi=E1=BA=BFutr=E1=
=BA=A3NL]Xemchiti=E1=BA=BFt-AC2:Hi=E1=BB=83nth=E1=BB=8BDanhs=C3=A1chnguy=C3=
=AAnli=E1=BB=87utr=E1=BA=A3(LineItems)">AC 2: Hi=E1=BB=83n th=E1=BB=8B Danh=
 s=C3=A1ch nguy=C3=AAn li=E1=BB=87u tr=E1=BA=A3 (Line Items)</h3>
<p class=3D"code-line"><strong>Given (Bi=E1=BA=BFt r=E1=BA=B1ng):</strong><=
span>&nbsp;</span>Ng=C6=B0=E1=BB=9Di d=C3=B9ng =C4=91ang =E1=BB=9F m=C3=A0n=
 h=C3=ACnh Chi ti=E1=BA=BFt Phi=E1=BA=BFu tr=E1=BA=A3 NL.<span>&nbsp;</span=
></p>
<p class=3D"code-line"><strong>Then (Th=C3=AC):</strong><span>&nbsp;</span>=
H=E1=BB=87 th=E1=BB=91ng hi=E1=BB=83n th=E1=BB=8B m=E1=BB=99t b=E1=BA=A3ng =
danh s=C3=A1ch c=C3=A1c m=C3=B3n nguy=C3=AAn li=E1=BB=87u c=E1=BA=A7n tr=E1=
=BA=A3 l=E1=BA=A1i, bao g=E1=BB=93m c=C3=A1c c=E1=BB=99t:</p>
<ul class=3D"code-line">
 <li class=3D"code-line" data-uuid=3D"427e8027-59b9-4692-b217-6382ce8c7da4"=
>STT, M=C3=A3 NL / M=C3=A3 Lot, T=C3=AAn lo=E1=BA=A1i NL (V=C3=A0ng/B=E1=BA=
=A1c/=C4=90=C3=A1...).</li>
 <li class=3D"code-line" data-uuid=3D"6fd12b2a-55eb-48cc-8e85-5dcf29a79bba"=
>S=E1=BB=91 l=C6=B0=E1=BB=A3ng / Tr=E1=BB=8Dng l=C6=B0=E1=BB=A3ng b=E1=BB=
=8B tr=E1=BA=A3.</li>
 <li class=3D"code-line" data-uuid=3D"e8e77bb8-a930-44e0-bcb0-1ee245ceb281"=
>L=C3=BD do tr=E1=BA=A3 h=C3=A0ng (L=E1=BB=87ch bao b=C3=AC, Kh=C3=B4ng =C4=
=91=E1=BA=A1t =C4=91o ph=E1=BB=95, Sai k=C3=ADch th=C6=B0=E1=BB=9Bc =C4=91=
=C3=A1...).</li>
 <li class=3D"code-line" data-uuid=3D"edf43524-288d-4994-b816-a99c1d7ff383"=
>H=C3=ACnh =E1=BA=A3nh/Video b=E1=BA=B1ng ch=E1=BB=A9ng l=E1=BB=97i (Thumbn=
ail c=C3=B3 th=E1=BB=83 click =C4=91=E1=BB=83 ph=C3=B3ng to xem chi ti=E1=
=BA=BFt).</li>
 <li class=3D"code-line" data-uuid=3D"784256e2-91fe-4ace-bb07-092948687174"=
>N=C3=BAt "H=C3=A0nh =C4=91=E1=BB=99ng" cho t=E1=BB=ABng d=C3=B2ng (n=E1=BA=
=BFu c=C3=B3, v=C3=AD d=E1=BB=A5: H=E1=BB=A7y tr=E1=BA=A3 - theo US-26.1).<=
/li>
</ul>
<h3 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E1.US27:[Phi=E1=BA=BFutr=E1=
=BA=A3NL]Xemchiti=E1=BA=BFt-AC3:Hi=E1=BB=83nth=E1=BB=8BL=E1=BB=8Bchs=E1=BB=
=ADho=E1=BA=A1t=C4=91=E1=BB=99ng(ActivityHistory/AuditTrail)">AC 3: Hi=E1=
=BB=83n th=E1=BB=8B L=E1=BB=8Bch s=E1=BB=AD ho=E1=BA=A1t =C4=91=E1=BB=99ng =
(Activity History / Audit Trail)</h3>
<p class=3D"code-line"><strong>Given (Bi=E1=BA=BFt r=E1=BA=B1ng):</strong><=
span>&nbsp;</span>Ng=C6=B0=E1=BB=9Di d=C3=B9ng cu=E1=BB=99n xu=E1=BB=91ng p=
h=E1=BA=A7n L=E1=BB=8Bch s=E1=BB=AD ho=E1=BA=A1t =C4=91=E1=BB=99ng ho=E1=BA=
=B7c chuy=E1=BB=83n sang tab "L=E1=BB=8Bch s=E1=BB=AD".<span>&nbsp;</span><=
/p>
<p class=3D"code-line"><strong>Then (Th=C3=AC):</strong><span>&nbsp;</span>=
H=E1=BB=87 th=E1=BB=91ng hi=E1=BB=83n th=E1=BB=8B d=C3=B2ng th=E1=BB=9Di gi=
an (Timeline) ghi nh=E1=BA=ADn c=C3=A1c s=E1=BB=B1 ki=E1=BB=87n:</p>
<ul class=3D"code-line">
 <li class=3D"code-line" data-uuid=3D"069cee2e-7d84-4b83-8486-9c3950780d26"=
>[Th=E1=BB=9Di gian] - [Ng=C6=B0=E1=BB=9Di th=E1=BB=B1c hi=E1=BB=87n] =C4=
=91=C3=A3 t=E1=BA=A1o phi=E1=BA=BFu tr=E1=BA=A3 NL t=E1=BB=AB Phi=E1=BA=BFu=
 ti=E1=BA=BFp nh=E1=BA=ADn [M=C3=A3 PTN].</li>
 <li class=3D"code-line" data-uuid=3D"442ba96e-35ca-42db-8dfe-a6cd2bdd1721"=
>[Th=E1=BB=9Di gian] - [Ng=C6=B0=E1=BB=9Di th=E1=BB=B1c hi=E1=BB=87n] =C4=
=91=C3=A3 in Bi=C3=AAn b=E1=BA=A3n tr=E1=BA=A3 h=C3=A0ng.</li>
 <li class=3D"code-line" data-uuid=3D"e32d2723-30a6-43c4-be5a-b58b4bc1cef0"=
>[Th=E1=BB=9Di gian] - [Ng=C6=B0=E1=BB=9Di th=E1=BB=B1c hi=E1=BB=87n] =C4=
=91=C3=A3 chuy=E1=BB=83n tr=E1=BA=A1ng th=C3=A1i sang "Ho=C3=A0n th=C3=A0nh=
" / "=C4=90=C3=A3 h=E1=BB=A7y" k=C3=A8m l=C3=BD do (n=E1=BA=BFu c=C3=B3).</=
li>
</ul>
<h3 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E1.US27:[Phi=E1=BA=BFutr=E1=
=BA=A3NL]Xemchiti=E1=BA=BFt-AC4:C=E1=BA=A5pquy=E1=BB=81ntruyc=E1=BA=ADp(RBA=
C)">AC 4: C=E1=BA=A5p quy=E1=BB=81n truy c=E1=BA=ADp (RBAC)</h3>
<p class=3D"code-line"><strong>Given (Bi=E1=BA=BFt r=E1=BA=B1ng):</strong><=
span>&nbsp;</span>M=E1=BB=99t ng=C6=B0=E1=BB=9Di d=C3=B9ng =C4=91=C4=83ng n=
h=E1=BA=ADp v=C3=A0o h=E1=BB=87 th=E1=BB=91ng.<span>&nbsp;</span></p>
<p class=3D"code-line"><strong>Then (Th=C3=AC):</strong></p>
<ul class=3D"code-line">
 <li class=3D"code-line" data-uuid=3D"78eb8354-c7bf-41f9-80cc-b6257dd5de45"=
>N=E1=BA=BFu l=C3=A0<span>&nbsp;</span><strong>Nh=C3=A2n vi=C3=AAn MC/Qu=E1=
=BA=A3n l=C3=BD</strong><span>&nbsp;</span>thu=E1=BB=99c chi nh=C3=A1nh/x=
=C6=B0=E1=BB=9Fng =C4=91=C3=B3: C=C3=B3 quy=E1=BB=81n xem to=C3=A0n b=E1=BB=
=99 th=C3=B4ng tin chi ti=E1=BA=BFt.</li>
 <li class=3D"code-line" data-uuid=3D"6c51160d-79b0-4218-b668-b392934bef47"=
>N=E1=BA=BFu l=C3=A0<span>&nbsp;</span><strong>Nh=C3=A2n vi=C3=AAn kh=C3=A1=
c</strong><span>&nbsp;</span>kh=C3=B4ng =C4=91=C6=B0=E1=BB=A3c ph=C3=A2n qu=
y=E1=BB=81n: H=E1=BB=87 th=E1=BB=91ng b=C3=A1o l=E1=BB=97i "B=E1=BA=A1n kh=
=C3=B4ng c=C3=B3 quy=E1=BB=81n truy c=E1=BA=ADp Phi=E1=BA=BFu n=C3=A0y" (Er=
ror 403) n=E1=BA=BFu c=E1=BB=91 t=C3=ACnh truy c=E1=BA=ADp qua URL.</li>
</ul>
<h3 class=3D"code-line" id=3D"id-=E2=9C=85CS1.E1.US27:[Phi=E1=BA=BFutr=E1=
=BA=A3NL]Xemchiti=E1=BA=BFt-3.THI=E1=BA=BETK=E1=BA=BE(UX/UI)">3. THI=E1=BA=
=BET K=E1=BA=BE (UX/UI)</h3>
<ul class=3D"code-line">
