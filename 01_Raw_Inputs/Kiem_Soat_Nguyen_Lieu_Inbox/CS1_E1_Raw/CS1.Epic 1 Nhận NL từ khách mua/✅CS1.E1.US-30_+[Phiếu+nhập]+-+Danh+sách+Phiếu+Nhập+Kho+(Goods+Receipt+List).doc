<ul class=3D"code-line">
 <li class=3D"code-line" data-uuid=3D"35ed0714-f2b6-4381-8d9d-59762194181b"=
><strong>BR-01:</strong><span>&nbsp;</span>Ch=E1=BB=89 hi=E1=BB=83n th=E1=
=BB=8B c=C3=A1c phi=E1=BA=BFu PNK =C4=91=C3=A3 =E1=BB=9F tr=E1=BA=A1ng th=
=C3=A1i Ho=C3=A0n th=C3=A0nh (=C4=90=C3=A3 Commit v=C3=A0o kho).</li>
 <li class=3D"code-line" data-uuid=3D"96cd1d4a-fed5-4fce-8407-833656503ec0"=
><strong>BR-02:</strong><span>&nbsp;</span>Kh=C3=B4ng hi=E1=BB=83n th=E1=BB=
=8B c=C3=A1c c=E1=BB=99t li=C3=AAn quan =C4=91=E1=BA=BFn t=C3=ADnh to=C3=A1=
n Ch=C3=AAnh l=E1=BB=87ch hay C=C3=B4ng n=E1=BB=A3 t=E1=BA=A1i m=C3=A0n h=
=C3=ACnh danh s=C3=A1ch t=E1=BB=95ng (Overview). C=C3=A1c th=C3=B4ng tin =
