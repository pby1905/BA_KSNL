<p class=3D"code-line"><strong>L=C3=A0 m=E1=BB=99t (As a):</strong><span>&n=
bsp;</span>Nh=C3=A2n vi=C3=AAn ti=E1=BA=BFp nh=E1=BA=ADn nguy=C3=AAn li=E1=
=BB=87u (MC).<span>&nbsp;</span><strong>T=C3=B4i mu=E1=BB=91n (I want):</st=
rong><span>&nbsp;</span>In bi=C3=AAn b=E1=BA=A3n tr=E1=BA=A3 nguy=C3=AAn li=
=E1=BB=87u kh=C3=A1ch h=C3=A0ng sau khi =C4=91=C3=A3 qua b=C6=B0=E1=BB=9Bc =
ki=E1=BB=83m =C4=91=E1=BB=8Bnh chi ti=E1=BA=BFt (=C4=90o ph=E1=BB=95, T=C3=
=ADnh =C4=91=C3=A1, Ki=E1=BB=83m m=C3=A3) nh=C6=B0ng kh=C3=B4ng =C4=91=E1=
=BA=A1t ti=C3=AAu chu=E1=BA=A9n. Bi=C3=AAn b=E1=BA=A3n n=C3=A0y s=E1=BA=BD =
t=E1=BB=95ng h=E1=BB=A3p chung t=E1=BA=A5t c=E1=BA=A3 c=C3=A1c m=C3=B3n h=
=C3=A0ng/d=C3=B2ng nguy=C3=AAn li=E1=BB=87u b=E1=BB=8B t=E1=BB=AB ch=E1=BB=
=91i trong c=C3=B9ng m=E1=BB=99t l=C3=B4, v=C3=A0 c=C3=B3 b=E1=BA=A3ng so s=
=C3=A1nh r=C3=B5 r=C3=A0ng gi=E1=BB=AFa s=E1=BB=91 li=E1=BB=87u kh=C3=A1ch =
b=C3=A1o v=C3=A0 s=E1=BB=91 li=E1=BB=87u th=E1=BB=B1c t=E1=BA=BF do X=C6=B0=
