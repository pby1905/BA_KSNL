<p><strong>When (Khi):</strong><br>
  Ng=C6=B0=E1=BB=9Di d=C3=B9ng nh=E1=BA=A5n thao t=C3=A1c <strong>T=E1=BA=
=A1o phi=E1=BA=BFu tr=E1=BA=A3 NL</strong> t=E1=BB=AB m=C3=A0n h=C3=ACnh ch=
i ti=E1=BA=BFt phi=E1=BA=BFu ti=E1=BA=BFp nh=E1=BA=ADn.</p>
<p><strong>Then (Th=C3=AC):</strong><br>
  H=E1=BB=87 th=E1=BB=91ng kh=E1=BB=9Fi t=E1=BA=A1o m=E1=BB=9Bi m=E1=BB=99t=
 phi=E1=BA=BFu tr=E1=BA=A3 nguy=C3=AAn li=E1=BB=87u v=E1=BB=9Bi:</p>
<ul>
 <li data-uuid=3D"c2767993-4bf0-4a0e-b312-af2edbe69ac8">Lo=E1=BA=A1i phi=E1=
