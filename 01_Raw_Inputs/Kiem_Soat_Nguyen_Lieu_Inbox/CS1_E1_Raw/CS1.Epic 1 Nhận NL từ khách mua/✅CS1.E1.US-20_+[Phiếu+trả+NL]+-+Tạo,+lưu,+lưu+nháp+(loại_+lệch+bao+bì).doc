   <li>Tr=E1=BB=8Dng l=C6=B0=E1=BB=A3ng th=E1=BB=B1c t=E1=BA=BF</li>
   <li>Gi=C3=A1 tr=E1=BB=8B ch=C3=AAnh l=E1=BB=87ch</li>
   <li>Ghi ch=C3=BA x=E1=BB=AD l=C3=BD ch=C3=AAnh l=E1=BB=87ch (n=E1=BA=BFu=
 c=C3=B3)</li>
  </ul></li>
</ul>
