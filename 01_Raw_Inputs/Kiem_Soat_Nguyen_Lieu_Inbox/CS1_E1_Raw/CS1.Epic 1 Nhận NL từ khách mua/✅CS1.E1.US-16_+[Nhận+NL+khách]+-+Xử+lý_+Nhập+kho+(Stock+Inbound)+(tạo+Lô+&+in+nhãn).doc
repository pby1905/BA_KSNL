<p><strong>L=C3=A0 m=E1=BB=99t:</strong> Nh=C3=A2n vi=C3=AAn ti=E1=BA=BFp n=
h=E1=BA=ADn nguy=C3=AAn li=E1=BB=87u.&nbsp;</p>
<p><strong>T=C3=B4i mu=E1=BB=91n:</strong> Th=E1=BB=B1c hi=E1=BB=87n nh=E1=
=BA=ADp kho c=C3=A1c d=C3=B2ng nguy=C3=AAn li=E1=BB=87u =C4=91=C3=A3 ho=C3=
