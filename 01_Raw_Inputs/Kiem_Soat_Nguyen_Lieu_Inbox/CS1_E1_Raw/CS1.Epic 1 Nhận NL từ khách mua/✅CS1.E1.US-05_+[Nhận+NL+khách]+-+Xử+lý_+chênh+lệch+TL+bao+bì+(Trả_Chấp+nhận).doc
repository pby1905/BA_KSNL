<ul>
 <li data-uuid=3D"83df8d0b-3a5f-43b9-886e-4de2fb30f49e">
  <p><strong>Given (Bi=E1=BA=BFt r=E1=BA=B1ng):</strong> Nh=C3=A2n vi=C3=AA=
n =C4=91ang =E1=BB=9F m=C3=A0n h=C3=ACnh chi ti=E1=BA=BFt phi=E1=BA=BFu ti=
=E1=BA=BFp nh=E1=BA=ADn NL (v=C3=AD d=E1=BB=A5: <code>NNL-2601-00001</code>=
).</p></li>
 <li data-uuid=3D"0e9e3570-17d6-41d7-93f2-1361c124ed48">
  <p><strong>When (Khi):</strong> Tr=E1=BB=8Dng l=C6=B0=E1=BB=A3ng th=E1=BB=
=B1c t=E1=BA=BF nh=E1=BA=ADp v=C3=A0o c=C3=B3 m=E1=BB=A9c ch=C3=AAnh l=E1=
=BB=87ch (Difference) so v=E1=BB=9Bi kh=C3=A1ch b=C3=A1o l=E1=BB=9Bn h=C6=
=A1n gi=C3=A1 tr=E1=BB=8B c=E1=BA=A5u h=C3=ACnh (v=C3=AD d=E1=BB=A5: &gt; 1=
 ph=C3=A2n).</p></li>
 <li data-uuid=3D"91cb22b1-09cb-4a4a-a903-f6c5c4807dfc">
  <p><strong>Then (Th=C3=AC):</strong> H=E1=BB=87 th=E1=BB=91ng hi=E1=BB=83=
n th=E1=BB=8B Banner c=E1=BA=A3nh b=C3=A1o m=C3=A0u v=C3=A0ng =E1=BB=9F =C4=
=91=E1=BA=A7u trang v=E1=BB=9Bi n=E1=BB=99i dung: <em>"Ph=C3=A1t hi=E1=BB=
=87n ch=C3=AAnh l=E1=BB=87ch (0.0104 l=C6=B0=E1=BB=A3ng) v=C6=B0=E1=BB=A3t =
m=E1=BB=A9c cho ph=C3=A9p (0.0100 l=C6=B0=E1=BB=A3ng). Vui l=C3=B2ng ra quy=
=E1=BA=BFt =C4=91=E1=BB=8Bnh x=E1=BB=AD l=C3=BD!"</em>.</p></li>
 <li data-uuid=3D"bf2c56a8-d4a3-4207-956d-0ccaeeca1e1e">
  <p><strong>And:</strong> Tr=C6=B0=E1=BB=9Dng "Ch=C3=AAnh l=E1=BB=87ch" =
=C4=91=C6=B0=E1=BB=A3c highlight m=C3=A0u =C4=91=E1=BB=8F =C4=91=E1=BB=83 g=
=C3=A2y ch=C3=BA =C3=BD.</p></li>
</ul>
