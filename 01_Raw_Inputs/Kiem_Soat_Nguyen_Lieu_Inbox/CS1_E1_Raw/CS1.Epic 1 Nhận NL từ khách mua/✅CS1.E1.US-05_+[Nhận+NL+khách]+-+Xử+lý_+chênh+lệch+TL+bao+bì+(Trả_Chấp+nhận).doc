khi tr=E1=BB=8Dng l=C6=B0=E1=BB=A3ng th=E1=BB=B1c t=E1=BA=BF sai l=E1=BB=87=
ch v=C6=B0=E1=BB=A3t m=E1=BB=A9c cho ph=C3=A9p so v=E1=BB=9Bi th=C3=B4ng ti=
n kh=C3=A1ch b=C3=A1o.</p>
<p><strong>=C4=90=E1=BB=83 (So that):</strong> =C4=90=E1=BA=A3m b=E1=BA=A3o=
 m=E1=BB=8Di r=E1=BB=A7i ro v=E1=BB=81 th=E1=BA=A5t tho=C3=A1t ho=E1=BA=B7c=
 sai s=C3=B3t nguy=C3=AAn li=E1=BB=87u =C4=91=E1=BB=81u ph=E1=BA=A3i =C4=91=
