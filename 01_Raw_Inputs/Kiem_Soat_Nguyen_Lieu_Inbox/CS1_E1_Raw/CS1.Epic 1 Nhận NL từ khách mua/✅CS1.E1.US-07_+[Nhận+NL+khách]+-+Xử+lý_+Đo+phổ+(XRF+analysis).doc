=BB=87u =C4=91=C3=A3 ti=E1=BA=BFp nh=E1=BA=ADn =E1=BB=9F b=C6=B0=E1=BB=9Bc =
tr=C6=B0=E1=BB=9Bc.</p></li>
 <li data-uuid=3D"55ba960e-8148-48e1-a2a0-02e638b0cce6"><strong>And:</stron=
g> Nh=C3=A2n vi=C3=AAn ch=E1=BB=8Dn c=C3=A1c d=C3=B2ng nguy=C3=AAn li=E1=BB=
=87u c=C3=B3 lo=E1=BA=A1i =3D "D=E1=BA=BB" nh=E1=BA=A5n v=C3=A0o n=C3=BAt "=
=C4=90o ph=E1=BB=95".</li>
 <li data-uuid=3D"6e4d9476-65c0-4898-a30c-202ac27b9a88">
  <p><strong>When:</strong> H=E1=BB=87 th=E1=BB=91ng hi=E1=BB=83n th=E1=BB=
=8B Modal "=C4=90o ph=E1=BB=95" (nh=C6=B0 h=C3=ACnh =E1=BA=A3nh thi=E1=BA=
=BFt k=E1=BA=BF).</p></li>
 <li data-uuid=3D"123990be-bd91-4a08-a9fc-e62338cbb0f9">
  <p><strong>Then:</strong> Nh=C3=A2n vi=C3=AAn c=C3=B3 th=E1=BB=83 nh=E1=
=BA=ADp c=C3=A1c th=C3=A0nh ph=E1=BA=A7n kim lo=E1=BA=A1i.</p></li>
</ul>
<p><strong>AC 2: Ki=E1=BB=83m tra t=E1=BB=95ng t=E1=BB=B7 l=E1=BB=87 th=C3=
=A0nh ph=E1=BA=A7n (Validation %)</strong></p>
