{line 1, line 2...} s=E1=BA=BD chuy=E1=BB=83n sang tr=E1=BA=A1ng th=C3=A1i =
"H=E1=BB=A7y". B=E1=BA=A1n c=C3=B3 ch=E1=BA=AFc ch=E1=BA=AFn mu=E1=BB=91n t=
