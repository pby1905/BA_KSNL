 <li data-uuid=3D"83c62db0-611e-4c99-928e-70c681847250"><strong>When: </str=
ong>Nh=C3=A2n vi=C3=AAn nh=E1=BA=A5n v=C3=A0o n=C3=BAt "=C4=90o ph=E1=BB=95=
"</li>
 <li><strong>Then: </strong>Hi=E1=BB=83n th=E1=BB=8B popup x=C3=A1c nh=E1=
