 <li data-uuid=3D"340a297d-e645-469f-befb-66906d1a7b67">
  <p><strong>Then:</strong> H=E1=BB=87 th=E1=BB=91ng ki=E1=BB=83m tra t=E1=
=BB=95ng %. N=E1=BA=BFu t=E1=BB=95ng <span class=3D"math-inline">% &gt; 100=
%</span>, hi=E1=BB=83n th=E1=BB=8B c=E1=BA=A3nh b=C3=A1o v=C3=A0 kh=C3=B4ng=
 cho l=C6=B0u.</p>
  <ul>
   <li data-uuid=3D"29292082-1c99-4e2b-b314-7496004b298e">
    <p><strong>VN: </strong>"T=E1=BB=95ng t=E1=BB=B7 l=E1=BB=87 c=C3=A1c th=
=C3=A0nh ph=E1=BA=A7n kim lo=E1=BA=A1i kh=C3=B4ng =C4=91=C6=B0=E1=BB=A3c v=
