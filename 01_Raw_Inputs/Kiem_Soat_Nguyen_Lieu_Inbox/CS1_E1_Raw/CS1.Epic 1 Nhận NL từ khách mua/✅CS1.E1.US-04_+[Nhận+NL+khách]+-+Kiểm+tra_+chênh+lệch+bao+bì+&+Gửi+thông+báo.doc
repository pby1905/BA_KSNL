 <li data-uuid=3D"dd3d3589-8190-43d2-b3d2-e136f70737cd">
  <p><strong>Then (Th=C3=AC):</strong></p>
  <ul>
   <li data-uuid=3D"0c35ba75-ca94-4518-a687-bd6f6ca98fc6">
    <p>1. Tr=E1=BA=A1ng th=C3=A1i phi=E1=BA=BFu chuy=E1=BB=83n th=C3=A0nh&n=
bsp;<strong>"=C4=90ang th=E1=BB=B1c hi=E1=BB=87n" </strong>v=C3=A0 hi=E1=BB=
