    <ul>
     <li data-uuid=3D"5d809678-01d3-4728-9517-bb3c23a2bda6">
      <p><em>VN: "Phi=E1=BA=BFu [M=C3=A3 phi=E1=BA=BFu] c=E1=BA=A7n ph=C3=
