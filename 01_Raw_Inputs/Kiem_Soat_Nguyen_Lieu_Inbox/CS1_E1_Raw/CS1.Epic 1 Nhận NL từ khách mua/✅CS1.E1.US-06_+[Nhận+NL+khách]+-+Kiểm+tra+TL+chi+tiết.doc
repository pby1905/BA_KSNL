    <h1>=E2=9C=85CS1.E1.US-06: [Nh=E1=BA=ADn NL kh=C3=A1ch] - Ki=E1=BB=83m =
tra TL chi ti=E1=BA=BFt</h1>
    <div class=3D"Section1">
        <h2 id=3D"id-=E2=9C=85CS1.E1.US06:[Nh=E1=BA=ADnNLkh=C3=A1ch]Ki=E1=
=BB=83mtraTLchiti=E1=BA=BFt-1.USERSTORY"><strong>1. USER STORY</strong></h2=
>
<p><strong>L=C3=A0 m=E1=BB=99t (As a):</strong> Nh=C3=A2n vi=C3=AAn Ti=E1=
=BA=BFp nh=E1=BA=ADn Nguy=C3=AAn li=E1=BB=87u</p>
<p><strong>T=C3=B4i mu=E1=BB=91n (I want):</strong> Nh=E1=BA=ADp li=E1=BB=
=87u chi ti=E1=BA=BFt ph=C3=A2n lo=E1=BA=A1i nguy=C3=AAn li=E1=BB=87u, tr=
=E1=BB=8Dng l=C6=B0=E1=BB=A3ng kh=C3=A1ch b=C3=A1o, tr=E1=BB=8Dng l=C6=B0=
=E1=BB=A3ng Seva c=C3=A2n th=E1=BB=B1c t=E1=BA=BF v=C3=A0 tu=E1=BB=95i v=C3=
=A0ng cho t=E1=BB=ABng d=C3=B2ng h=C3=A0ng</p>
<p><strong>=C4=90=E1=BB=83 (So that):</strong> H=E1=BB=87 th=E1=BB=91ng ghi=
 nh=E1=BA=ADn d=E1=BB=AF li=E1=BB=87u b=C3=B3c t=C3=A1ch chi ti=E1=BA=BFt l=
=C3=A0m c=C6=A1 s=E1=BB=9F t=C3=ADnh to=C3=A1n quy =C4=91=E1=BB=95i v=C3=A0=
ng r=C3=B2ng (Quy 9999) v=C3=A0 =C4=91=E1=BB=91i chi=E1=BA=BFu sai l=E1=BB=
=87ch tr=C6=B0=E1=BB=9Bc khi x=E1=BB=AD l=C3=BD ti=E1=BA=BFp.</p>
<hr>
<h2 id=3D"id-=E2=9C=85CS1.E1.US06:[Nh=E1=BA=ADnNLkh=C3=A1ch]Ki=E1=BB=83mtra=
TLchiti=E1=BA=BFt-2.TI=C3=8AUCH=C3=8DCH=E1=BA=A4PNH=E1=BA=ACN(ACCEPTANCECRI=
TERIA-AC)"><strong>2. TI=C3=8AU CH=C3=8D CH=E1=BA=A4P NH=E1=BA=ACN (ACCEPTA=
NCE CRITERIA - AC)</strong></h2>
<h3 id=3D"id-=E2=9C=85CS1.E1.US06:[Nh=E1=BA=ADnNLkh=C3=A1ch]Ki=E1=BB=83mtra=
TLchiti=E1=BA=BFt-AC1:Hi=E1=BB=83nth=E1=BB=8Bth=C3=B4ngtinti=E1=BA=BFntr=C3=
=ACnhv=C3=A0th=C3=B4ngtinchung">AC 1: Hi=E1=BB=83n th=E1=BB=8B th=C3=B4ng t=
in ti=E1=BA=BFn tr=C3=ACnh v=C3=A0 th=C3=B4ng tin chung</h3>
<ul>
 <li data-uuid=3D"6884ade8-37d9-49a5-acee-54cdf63e823e">
  <p><strong>Given (Bi=E1=BA=BFt r=E1=BA=B1ng):</strong> Nh=C3=A2n vi=C3=AA=
n =C4=91=C3=A3 x=C3=A1c nh=E1=BA=ADn bao b=C3=AC th=C3=A0nh c=C3=B4ng =E1=
=BB=9F b=C6=B0=E1=BB=9Bc 1.</p></li>
 <li data-uuid=3D"2d90ad6b-cecd-4722-819a-e9a7e1dd2975">
  <p><strong>When (Khi):</strong> Truy c=E1=BA=ADp v=C3=A0o chi ti=E1=BA=BF=
t phi=E1=BA=BFu</p></li>
 <li data-uuid=3D"b53e52a3-a134-4576-aee2-1769dd405942">
  <p><strong>Then (Th=C3=AC):</strong>&nbsp;</p>
  <ul>
   <li data-uuid=3D"ad4b0d26-8276-428f-a33e-8625b32fcb7a">
    <p>H=E1=BB=87 th=E1=BB=91ng hi=E1=BB=83n th=E1=BB=8B&nbsp;<strong>Stepp=
er</strong> g=E1=BB=93m 3 b=C6=B0=E1=BB=9Bc: 1. X=C3=A1c nh=E1=BA=ADn bao b=
=C3=AC (=C4=91=C3=A3 ho=C3=A0n th=C3=A0nh), 2. Ki=E1=BB=83m tra tr=E1=BB=8D=
ng l=C6=B0=E1=BB=A3ng chi ti=E1=BA=BFt (=C4=91ang th=E1=BB=B1c hi=E1=BB=87n=
), 3. X=E1=BB=AD l=C3=BD t=E1=BB=ABng lo=E1=BA=A1i.</p></li>
   <li>
    <p>Hi=E1=BB=83n th=E1=BB=8B <strong>Th=C3=B4ng tin chung</strong> (Kh=
=C3=A1ch h=C3=A0ng, L=C3=B4, Ng=C3=A0y ti=E1=BA=BFp nh=E1=BA=ADn...) v=C3=
=A0 <strong>L=E1=BB=8Bch s=E1=BB=AD ho=E1=BA=A1t =C4=91=E1=BB=99ng</strong>=
 c=E1=BB=A7a phi=E1=BA=BFu.</p></li>
  </ul></li>
</ul>
<h3 id=3D"id-=E2=9C=85CS1.E1.US06:[Nh=E1=BA=ADnNLkh=C3=A1ch]Ki=E1=BB=83mtra=
TLchiti=E1=BA=BFt-AC2:T=E1=BB=B1=C4=91=E1=BB=99ngt=C3=ADnhto=C3=A1ntr=C3=AA=
nt=E1=BB=ABngd=C3=B2ng(RowCalculation)">AC 2: T=E1=BB=B1 =C4=91=E1=BB=99ng =
t=C3=ADnh to=C3=A1n tr=C3=AAn t=E1=BB=ABng d=C3=B2ng (Row Calculation)</h3>
<ul>
 <li data-uuid=3D"9c101bd5-97fe-406a-a9fb-ee6fb41bfc83">
  <p><strong>Given (Bi=E1=BA=BFt r=E1=BA=B1ng):</strong> Nh=C3=A2n vi=C3=AA=
n nh=E1=BA=ADp d=E1=BB=AF li=E1=BB=87u v=C3=A0o c=C3=A1c c=E1=BB=99t t=C6=
=B0=C6=A1ng =E1=BB=A9ng.</p></li>
 <li data-uuid=3D"26006e84-4106-4b53-85ea-ca1f7c9f1989">
  <p><strong>When (Khi):</strong> D=E1=BB=AF li=E1=BB=87u thay =C4=91=E1=BB=
=95i.</p></li>
 <li data-uuid=3D"ab70729a-e512-432a-a9fb-718beed09509">
  <p><strong>Then (Th=C3=AC):</strong> H=E1=BB=87 th=E1=BB=91ng t=E1=BB=B1 =
=C4=91=E1=BB=99ng t=C3=ADnh to=C3=A1n theo c=C3=B4ng th=E1=BB=A9c:</p>
  <ul>
   <li>
    <p><strong>TL - kh=C3=A1ch</strong> =3D [TL t=E1=BB=95ng - kh=C3=A1ch] =
- [TL =C4=91=C3=A1 - kh=C3=A1ch].</p></li>
   <li>
    <p><strong>Quy 99.99 - kh=C3=A1ch</strong> =3D ([TL - kh=C3=A1ch] * [Tu=
=E1=BB=95i - kh=C3=A1ch]) / 99.99.</p></li>
  </ul></li>
</ul>
<h3 id=3D"id-=E2=9C=85CS1.E1.US06:[Nh=E1=BA=ADnNLkh=C3=A1ch]Ki=E1=BB=83mtra=
TLchiti=E1=BA=BFt-AC3:T=E1=BB=95ngh=E1=BB=A3pd=E1=BB=AFli=E1=BB=87ucu=E1=BB=
=91ib=E1=BA=A3ng(FooterSummary)">AC 3: T=E1=BB=95ng h=E1=BB=A3p d=E1=BB=AF =
li=E1=BB=87u cu=E1=BB=91i b=E1=BA=A3ng (Footer Summary)</h3>
<ul>
 <li data-uuid=3D"73d7d0ad-9b0a-4ae5-b54b-5387f1d72f34">
  <p><strong>Given (Bi=E1=BA=BFt r=E1=BA=B1ng):</strong> B=E1=BA=A3ng c=C3=
=B3 nhi=E1=BB=81u d=C3=B2ng d=E1=BB=AF li=E1=BB=87u.</p></li>
 <li data-uuid=3D"ca46ce0a-8148-4535-bfbb-00f0b41e4e55">
  <p><strong>Then (Th=C3=AC):</strong> D=C3=B2ng <strong>T=E1=BB=95ng</stro=
ng> =E1=BB=9F cu=E1=BB=91i b=E1=BA=A3ng ph=E1=BA=A3i t=E1=BB=B1 =C4=91=E1=
=BB=99ng c=E1=BA=ADp nh=E1=BA=ADt t=E1=BB=95ng c=E1=BB=99ng c=E1=BB=A7a c=
=C3=A1c c=E1=BB=99t: TL t=E1=BB=95ng - kh=C3=A1ch, TL =C4=91=C3=A1 - kh=C3=
=A1ch, TL - kh=C3=A1ch, Quy 9999 - kh=C3=A1ch, TL t=E1=BB=95ng - Seva, v=C3=
=A0 Ti=E1=BB=81n c=C3=B4ng - kh=C3=A1ch.</p></li>
</ul>
<h3 id=3D"id-=E2=9C=85CS1.E1.US06:[Nh=E1=BA=ADnNLkh=C3=A1ch]Ki=E1=BB=83mtra=
